                  <div style="font-size:11px; color:var(--text-muted);">
                    <span style="color:#4ade80;">🟢 Tiếp tục</span> | <span style="color:#f87171;">🔴 Cần xử lý thêm</span> | <span style="color:#d8b4fe;">🟣 Chuyển duyệt</span>
                  </div>
                </div>

                <div style="margin-bottom:14px;">
                  <div style="font-size:11.5px; font-weight:800; color:var(--text-muted); margin-bottom:4px; text-transform:uppercase;">💬 Yêu cầu gốc từ khách hàng:</div>
                  <div id="inspRawText" style="background:var(--card-inner-bg); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); border:1px solid var(--card-inner-border); padding:10px 14px; border-radius:12px; font-size:12.5px; color:#ffffff; box-shadow:var(--card-inner-shadow);"></div>
                </div>

                <div style="margin-bottom:14px;">
                  <div style="font-size:11.5px; font-weight:800; color:var(--text-muted); margin-bottom:6px; text-transform:uppercase;">📦 Bảng đối chiếu Hạng mục &amp; Tồn kho ATP:</div>
                  <div id="inspItemsTable"></div>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center; background:var(--card-inner-bg); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); border:1px solid var(--card-inner-border); padding:12px 16px; border-radius:14px; box-shadow:var(--card-inner-shadow);">
                  <div>
                    <div style="font-size:11px; color:var(--text-muted);">Giá niêm yết: <span id="inspListPrice" style="font-weight:700; color:#ffffff;">-</span> • Chiết khấu: <span id="inspDiscountRate" style="font-weight:700; color:#ffffff;">-</span></div>
                    <div style="font-size:17px; font-weight:900; color:#fb7185; text-shadow:0 2px 10px rgba(0,0,0,0.5);" id="inspFinalTotal">-</div>
                  </div>
                  <div id="inspHitlButtons"></div>
                </div>
              </div>

              <!-- SUBTAB 2: HỒ SƠ CƠ HỘI BÁN HÀNG CHI TIẾT (Ô CHỮ KÍNH MỜ) -->
              <div id="insp-tab-dossier" class="insp-pane">
                <div class="code-box-glass" id="inspDossierContent"></div>
              </div>

              <!-- SUBTAB 3: BẢN NHÁP EMAIL PHẢN HỒI KHÁCH HÀNG (Ô CHỮ KÍNH MỜ) -->
              <div id="insp-tab-email" class="insp-pane">
                <div class="code-box-glass" id="inspEmailContent"></div>
              </div>

              <!-- SUBTAB 4: PHIẾU CHUYỂN DUYỆT SẾP (Ô CHỮ KÍNH MỜ) -->
              <div id="insp-tab-ticket" class="insp-pane">
                <div class="code-box-glass" id="inspTicketContent"></div>
              </div>

              <!-- SUBTAB 5: NHẬT KÝ TRACE CHI TIẾT 6 BƯỚC (CÁC Ô KÍNH MỜ XẾP TẦNG) -->
              <div id="insp-tab-trace" class="insp-pane">
                <div id="inspTraceContent" style="display:flex; flex-direction:column; gap:8px;"></div>
              </div>

              <!-- SUBTAB 6: ĐỐI CHIẾU KHO ATP (Ô CHỮ KÍNH MỜ) -->
              <div id="insp-tab-stock" class="insp-pane">
                <div id="inspStockContent"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

    </div>

    <!-- VIEW 2: ĐỘI NGŨ NVKD (6 SALES) -->
    <div id="view-sales" class="main-tab-view" style="display:none;">
      <div style="background:var(--glass-panel-bg); backdrop-filter:blur(26px) saturate(150%); -webkit-backdrop-filter:blur(26px) saturate(150%); border:1px solid var(--glass-panel-border); border-radius:24px; padding:24px; box-shadow:var(--glass-panel-shadow);">
        <h2 style="font-size:18px; font-weight:900; margin-bottom:14px; color:#ffffff;">👥 Đội ngũ Nhân viên Kinh doanh (6 Sales Reps Minh An)</h2>
        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:16px;" id="salesRepsGrid"></div>
      </div>
    </div>

    <!-- VIEW 3: BẢNG GIÁ MASTER -->
    <div id="view-catalog" class="main-tab-view" style="display:none;">
      <div style="background:var(--glass-panel-bg); backdrop-filter:blur(26px) saturate(150%); -webkit-backdrop-filter:blur(26px) saturate(150%); border:1px solid var(--glass-panel-border); border-radius:24px; padding:24px; box-shadow:var(--glass-panel-shadow);">
        <h2 style="font-size:18px; font-weight:900; margin-bottom:14px; color:#ffffff;">🏷️ Bảng Giá Master &amp; Tồn Kho Thiết Bị</h2>
        <div style="overflow-x:auto;">
          <table class="clean-table" id="masterCatalogTable">
            <thead>
              <tr>
                <th>Mã SP</th>
                <th>Tên Thiết Bị / Dịch Vụ</th>
                <th>Danh Mục</th>
                <th>Đơn Giá Niêm Yết</th>
                <th>Tồn Khả Dụng</th>
                <th>Lead Time Có Sẵn</th>
                <th>Lead Time Đặt Hàng</th>
              </tr>
            </thead>
            <tbody id="masterCatalogBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- VIEW 4: TỒN KHẢ DỤNG & LEAD TIME -->
    <div id="view-inventory" class="main-tab-view" style="display:none;">
      <div style="background:var(--glass-panel-bg); backdrop-filter:blur(26px) saturate(150%); -webkit-backdrop-filter:blur(26px) saturate(150%); border:1px solid var(--glass-panel-border); border-radius:24px; padding:24px; box-shadow:var(--glass-panel-shadow);">
        <h2 style="font-size:18px; font-weight:900; margin-bottom:14px; color:#ffffff;">📦 Quy Tắc Thẩm Định Tồn Kho Khả Dụng &amp; SLA Triển Khai</h2>
        <p style="font-size:13px; color:var(--text-muted); line-height:1.6; margin-bottom:16px;">
          Hệ thống AI Agent tự động truy vấn tồn kho khả dụng (ATP). Nếu số lượng yêu cầu &le; tồn sẵn có, SLA là 1–3 ngày làm việc. Nếu vượt tồn kho sẵn có, AI Agent tự động chuyển sang Lead time nhập hàng từ hãng (7–21 ngày) và kiểm tra đối chiếu hạn chót của khách hàng.
        </p>
        <div id="inventoryRulesCards" style="display:grid; grid-template-columns:1fr 1fr; gap:16px;"></div>
      </div>
    </div>

    <!-- VIEW 5: CHÍNH SÁCH PHÊ DUYỆT -->
    <div id="view-policies" class="main-tab-view" style="display:none;">
      <div style="background:var(--glass-panel-bg); backdrop-filter:blur(26px) saturate(150%); -webkit-backdrop-filter:blur(26px) saturate(150%); border:1px solid var(--glass-panel-border); border-radius:24px; padding:24px; box-shadow:var(--glass-panel-shadow);">
        <h2 style="font-size:18px; font-weight:900; margin-bottom:14px; color:#ffffff;">⚖️ Ma Trận Thẩm Quyền Phê Duyệt &amp; Chiết Khấu Theo Quy Mô</h2>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:18px;">
          <div>
            <h3 style="font-size:14px; font-weight:800; margin-bottom:10px; color:#ffffff;">🏷️ Bậc Chiết Khấu Chuẩn (Volume Discount)</h3>
            <table class="clean-table">
              <thead><tr><th>Quy mô đơn hàng</th><th>Chiết khấu tối đa</th></tr></thead>
              <tbody>
                <tr><td>Dưới 50.000.000 VND</td><td><strong>0%</strong> (Không CK)</td></tr>
                <tr><td>50.000.000 – 100.000.000 VND</td><td><strong>5%</strong></td></tr>
                <tr><td>100.000.000 – 200.000.000 VND</td><td><strong>8%</strong></td></tr>
                <tr><td>Trên 200.000.000 VND</td><td><strong>10%</strong></td></tr>
              </tbody>
            </table>
          </div>
          <div>
            <h3 style="font-size:14px; font-weight:800; margin-bottom:10px; color:#ffffff;">👔 Phân Cấp Thẩm Quyền (HITL)</h3>
            <table class="clean-table">
              <thead><tr><th>Cấp duyệt</th><th>Hạn mức chiết khấu</th><th>Hạn mức giá trị</th></tr></thead>
              <tbody>
                <tr><td><strong>6 NVKD tự quyết</strong></td><td>&le; 10% (trong khung)</td><td>&le; 200M VND</td></tr>
                <tr><td><strong>Trưởng phòng KD</strong></td><td>&le; 15% (vượt khung)</td><td>&gt; 200M VND</td></tr>
                <tr><td><strong>Ban Giám Đốc</strong></td><td>Ngoại lệ đặc biệt</td><td>Hợp đồng chiến lược</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- =========================================================================
         VIEW 2: TIẾP NHẬN YÊU CẦU B2B (FORM NHẬP + UPLOAD JSON/CSV)
         ========================================================================= -->
    <div id="view-intake" class="main-tab-view" style="display:none;">
      <div style="background:var(--glass-panel-bg); backdrop-filter:blur(26px) saturate(150%); -webkit-backdrop-filter:blur(26px) saturate(150%); border:1px solid var(--glass-panel-border); border-radius:24px; padding:24px; box-shadow:var(--glass-panel-shadow); margin-bottom:20px;">
        <h2 style="font-size:18px; font-weight:900; margin-bottom:6px; color:#ffffff;">📥 Phân Hệ Tiếp Nhận Yêu Cầu Mua Hàng B2B</h2>
        <p style="font-size:12.5px; color:var(--text-muted); margin-bottom:20px;">
          Hệ thống hỗ trợ nhập liệu trực tiếp bằng biểu mẫu nghiệp vụ hoặc tải lên hàng loạt qua tệp JSON/CSV. Tự động kiểm tra tính hợp lệ, phát hiện thiếu thông tin và chống trùng lặp dữ liệu.
        </p>

        <div style="display:grid; grid-template-columns:1.2fr 0.8fr; gap:22px;">
          <!-- CỘT TRÁI: FORM NHẬP TRỰC TIẾP -->
          <div style="background:var(--card-inner-bg); border:1px solid var(--card-inner-border); border-radius:18px; padding:20px; box-shadow:var(--card-inner-shadow);">
            <div style="font-size:14px; font-weight:800; margin-bottom:14px; color:#ffffff; display:flex; align-items:center; gap:8px;">
              <span>📝</span> <span>Biểu Mẫu Nhập Yêu Cầu B2B Trực Tiếp</span>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
              <div>
                <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">TÊN DOANH NGHIỆP / KHÁCH HÀNG *</label>
                <input type="text" id="intakeCustName" class="sc-textarea" style="height:38px; resize:none;" placeholder="VD: Tập đoàn Công nghệ VinaTech" />
              </div>
              <div>
                <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">EMAIL LIÊN HỆ *</label>
                <input type="email" id="intakeEmail" class="sc-textarea" style="height:38px; resize:none;" placeholder="procurement@vinatech.vn" />
              </div>
            </div>

            <div style="display:grid; grid-template-columns:1.5fr 1fr; gap:12px; margin-bottom:12px;">
              <div>
                <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">CHỌN THIẾT BỊ / DỊCH VỤ CHÍNH *</label>
                <select id="intakeProductSelect" class="sc-textarea" style="height:38px; padding:4px 10px; background:rgba(28,15,24,0.9);">
                  <option value="PROD-001">Laptop Dell Latitude 5540 (Core i7, 16GB) - 25.000.000 đ</option>
                  <option value="PROD-002">Máy chủ HPE ProLiant DL380 Gen10 - 85.000.000 đ</option>
                  <option value="PROD-003">Cisco Catalyst Switch 24-Port Gigabit - 18.000.000 đ</option>
                  <option value="PROD-004">Bộ phát WiFi 6 Cisco Business 150AX - 3.500.000 đ</option>
                  <option value="PROD-005">Gói Dịch vụ Triển khai &amp; Cài đặt - 10.000.000 đ</option>
                </select>
              </div>
              <div>
                <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">SỐ LƯỢNG YÊU CẦU *</label>
                <input type="number" id="intakeQty" class="sc-textarea" style="height:38px; resize:none;" value="4" min="1" />
              </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:14px;">
              <div>
                <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">NGÂN SÁCH DỰ KIẾN (VND)</label>
                <input type="number" id="intakeBudget" class="sc-textarea" style="height:38px; resize:none;" placeholder="VD: 150000000" />
              </div>
              <div>
                <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">THỜI HẠN (NGÀY)</label>
                <input type="number" id="intakeDeadline" class="sc-textarea" style="height:38px; resize:none;" placeholder="VD: 7" />
              </div>
              <div>
                <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">CHIẾT KHẤU ĐỀ NGHỊ (%)</label>
                <input type="number" id="intakeDiscount" class="sc-textarea" style="height:38px; resize:none;" placeholder="VD: 8" step="0.5" />
              </div>
            </div>

            <div>
              <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">VĂN BẢN GỐC TỪ KHÁCH HÀNG (EMAIL / THƯ CHÀO GIÁ)</label>
              <textarea id="intakeRawText" class="sc-textarea" rows="3" placeholder="Dán nội dung email yêu cầu từ khách hàng..."></textarea>
            </div>

            <button class="run-pipeline-btn" style="margin-top:10px;" onclick="submitManualInquiry()">
              📥 Tiếp Nhận &amp; Kích Hoạt AI Agent Xử Lý Ngay
            </button>
          </div>

          <!-- CỘT PHẢI: TẢI LÊN FILE JSON / CSV -->
          <div style="background:var(--card-inner-bg); border:1px solid var(--card-inner-border); border-radius:18px; padding:20px; box-shadow:var(--card-inner-shadow); display:flex; flex-direction:column; justify-content:space-between;">
            <div>
              <div style="font-size:14px; font-weight:800; margin-bottom:14px; color:#ffffff; display:flex; align-items:center; gap:8px;">
                <span>📁</span> <span>Nạp Tệp Yêu Cầu Hàng Loạt (Batch Upload)</span>
              </div>
              <p style="font-size:12px; color:var(--text-muted); line-height:1.5; margin-bottom:16px;">
                Tải lên tệp <code>.json</code> hoặc <code>.csv</code> chứa danh sách các cơ hội bán hàng. AI Agent sẽ tự động chuẩn hóa, kiểm tra trùng lặp và tính toán năng lực đáp ứng theo lô.
              </p>

              <div style="border:2px dashed var(--glass-panel-border); border-radius:16px; padding:28px 16px; text-align:center; background:rgba(255,255,255,0.04); margin-bottom:14px;">
                <div style="font-size:32px; margin-bottom:8px;">📑</div>
                <div style="font-size:12.5px; font-weight:700; color:#ffffff; margin-bottom:4px;">Kéo thả tệp hoặc bấm để chọn tệp</div>
                <div style="font-size:11px; color:var(--text-muted); margin-bottom:14px;">Hỗ trợ định dạng: .JSON, .CSV (Chuẩn AI301)</div>
                <label class="glass-controls-btn" style="display:inline-block; cursor:pointer;">
                  📂 Chọn tệp từ máy tính
                  <input type="file" id="batchFileUploadInput" accept=".json,.csv" style="display:none;" onchange="handleBatchFileUpload(event)" />
                </label>
              </div>

              <div id="uploadFeedback" style="font-size:11.5px; color:#86efac; line-height:1.4;"></div>
            </div>

            <button class="glass-controls-btn" style="width:100%; text-align:center; padding:12px;" onclick="loadDataset('exam')">
              ⚡ Nạp Nhanh Bộ Đề Thi Mẫu Chuẩn AI301
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- =========================================================================
         VIEW 3: AI AGENT WORKSPACE (TIẾN TRÌNH 3 SKILLS & LOGS)
         ========================================================================= -->
    <div id="view-agent" class="main-tab-view" style="display:none;">
      <div style="background:var(--glass-panel-bg); backdrop-filter:blur(26px) saturate(150%); -webkit-backdrop-filter:blur(26px) saturate(150%); border:1px solid var(--glass-panel-border); border-radius:24px; padding:24px; box-shadow:var(--glass-panel-shadow);">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; flex-wrap:wrap; gap:10px;">
          <div>
            <h2 style="font-size:18px; font-weight:900; color:#ffffff;">🤖 AI Agent – Không Gian Xử Lý Độc Lập (3 Skills Điều Phối)</h2>
            <div style="font-size:12px; color:var(--text-muted);">Điều phối tuần tự các Skills nghiệp vụ bóc tách, đối chiếu kho &amp; tạo hồ sơ</div>
          </div>
          <button class="run-pipeline-btn" style="width:auto; padding:8px 18px; font-size:12.5px;" onclick="runAgentOnAllInquiries()">
            🚀 Chạy AI Agent Trên Toàn Bộ Danh Sách
          </button>
        </div>

        <!-- 3 SKILLS PIPELINE CARDS -->
        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:16px; margin-bottom:20px;">
          <div style="background:var(--card-inner-bg); border:1px solid var(--card-inner-border); border-radius:16px; padding:16px; box-shadow:var(--card-inner-shadow);">
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
              <span style="font-size:18px;">🔍</span>
              <strong style="color:#ffffff; font-size:13px;">Skill 1: requirement_analysis</strong>
            </div>
            <div style="font-size:11px; color:var(--text-muted); line-height:1.45;">
              Đọc yêu cầu, trích xuất thực thể (sản phẩm, số lượng, ngân sách, deadline, CK) và phát hiện trường thông tin thiếu hoặc không hợp lệ.
            </div>
            <div style="margin-top:10px; font-size:11px; font-weight:800; color:#86efac;">● Tool: tool_extract_and_validate</div>
          </div>

          <div style="background:var(--card-inner-bg); border:1px solid var(--card-inner-border); border-radius:16px; padding:16px; box-shadow:var(--card-inner-shadow);">
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
              <span style="font-size:18px;">⚖️</span>
              <strong style="color:#ffffff; font-size:13px;">Skill 2: opportunity_evaluation</strong>
            </div>
            <div style="font-size:11px; color:var(--text-muted); line-height:1.45;">
              Tra cứu tồn kho ATP, bảng giá Master, tính chiết khấu theo quy mô, đối chiếu lead time và kiểm tra ma trận thẩm quyền phê duyệt.
            </div>
            <div style="margin-top:10px; font-size:11px; font-weight:800; color:#38bdf8;">● Tool: tool_evaluate_feasibility_and_pricing</div>
          </div>

          <div style="background:var(--card-inner-bg); border:1px solid var(--card-inner-border); border-radius:16px; padding:16px; box-shadow:var(--card-inner-shadow);">
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
              <span style="font-size:18px;">📑</span>
              <strong style="color:#ffffff; font-size:13px;">Skill 3: sales_document_generator</strong>
            </div>
            <div style="font-size:11px; color:var(--text-muted); line-height:1.45;">
              Tự động khởi tạo Dossier Markdown, Dự thảo Email phản hồi chào giá và Phiếu chuyển duyệt ngoại lệ trình Trưởng phòng.
            </div>
            <div style="margin-top:10px; font-size:11px; font-weight:800; color:#fde047;">● Tool: tool_generate_dossier_email_ticket</div>
          </div>
        </div>

        <div id="agentTraceLiveFeed" class="code-box-glass" style="max-height:360px;">
          // Bấm "Chạy AI Agent Trên Toàn Bộ Danh Sách" hoặc chọn kịch bản ở Dashboard để theo dõi luồng gọi Skills và Tools thực tế...
        </div>
      </div>
    </div>

    <!-- =========================================================================
         VIEW 6: HỒ SƠ CƠ HỘI BÁN HÀNG B2B (DOSSIERS)
         ========================================================================= -->
    <div id="view-dossiers" class="main-tab-view" style="display:none;">
      <div style="background:var(--glass-panel-bg); backdrop-filter:blur(26px) saturate(150%); -webkit-backdrop-filter:blur(26px) saturate(150%); border:1px solid var(--glass-panel-border); border-radius:24px; padding:24px; box-shadow:var(--glass-panel-shadow);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:10px;">
          <div>
            <h2 style="font-size:18px; font-weight:900; color:#ffffff;">📑 Danh Sách Hồ Sơ Cơ Hội Bán Hàng B2B</h2>
            <div style="font-size:12px; color:var(--text-muted);">Tự động tạo hồ sơ, tính toán chiết khấu và phân loại theo thẩm quyền từ Database</div>
          </div>
          <div style="display:flex; gap:8px;">
            <button class="glass-controls-btn" onclick="filterDossiers('all')">Tất cả</button>
            <button class="glass-controls-btn" onclick="filterDossiers('Có thể tiếp tục')">🟢 Có thể tiếp tục</button>
            <button class="glass-controls-btn" onclick="filterDossiers('Chờ duyệt')">🟡 Chờ duyệt</button>
            <button class="glass-controls-btn" onclick="filterDossiers('Cần bổ sung')">🔴 Cần bổ sung</button>
            <button class="glass-controls-btn" onclick="filterDossiers('Chưa đáp ứng')">⚪ Chưa đáp ứng</button>
          </div>
        </div>

        <div style="overflow-x:auto;">
          <table class="clean-table" id="allDossiersTable">
            <thead>
              <tr>
                <th>Mã Hồ Sơ</th>
                <th>Khách Hàng</th>
                <th>Trạng Thái</th>
                <th>Giá Đề Xuất (VND)</th>
                <th>Chiết Khấu</th>
                <th>Lead Time</th>
                <th>NVKD Phụ Trách</th>
                <th>Thao Tác</th>
              </tr>
            </thead>
            <tbody id="allDossiersBody">
              <!-- Render dynamically from API -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- =========================================================================
         VIEW 7: PHÂN HỆ PHÊ DUYỆT NGOẠI LỆ (HITL)
         ========================================================================= -->
    <div id="view-approvals" class="main-tab-view" style="display:none;">
      <div style="background:var(--glass-panel-bg); backdrop-filter:blur(26px) saturate(150%); -webkit-backdrop-filter:blur(26px) saturate(150%); border:1px solid var(--glass-panel-border); border-radius:24px; padding:24px; box-shadow:var(--glass-panel-shadow);">
        <h2 style="font-size:18px; font-weight:900; margin-bottom:6px; color:#ffffff;">👔 Phân Hệ Phê Duyệt Ngoại Lệ (Human-in-the-Loop)</h2>
        <p style="font-size:12.5px; color:var(--text-muted); line-height:1.5; margin-bottom:20px;">
          Khu vực dành cho Trưởng phòng Kinh doanh (Hoàng Minh Trí) hoặc Ban Giám Đốc rà soát các cơ hội vượt thẩm quyền NVKD (&gt; 200 triệu VND hoặc chiết khấu vượt khung). Quyết định được lưu bền vững vào Database và ghi nhật ký truy vết.
        </p>

        <h3 style="font-size:14px; font-weight:800; color:#fde047; margin-bottom:12px;">⏳ Danh Sách Hồ Sơ Đang Chờ Phê Duyệt</h3>
        <div id="pendingApprovalsContainer" style="display:flex; flex-direction:column; gap:14px; margin-bottom:26px;">
          <!-- Dynamically populated from /api/approvals -->
        </div>

        <h3 style="font-size:14px; font-weight:800; color:#86efac; margin-bottom:12px;">✅ Lịch Sử Các Quyết Định Đã Phê Duyệt</h3>
        <div style="overflow-x:auto;">
          <table class="clean-table" id="approvalsHistoryTable">
            <thead>
              <tr>
                <th>Mã Quyết Định</th>
                <th>Mã Cơ Hội</th>
                <th>Quyết Định</th>
                <th>Người Phê Duyệt</th>
                <th>Ý Kiến / Ghi Chú</th>
                <th>Thời Gian</th>
              </tr>
            </thead>
            <tbody id="approvalsHistoryBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- =========================================================================
         VIEW 8: AUDIT LOG & TEST SUITE
         ========================================================================= -->
    <div id="view-audit" class="main-tab-view" style="display:none;">
      <div style="background:var(--glass-panel-bg); backdrop-filter:blur(26px) saturate(150%); -webkit-backdrop-filter:blur(26px) saturate(150%); border:1px solid var(--glass-panel-border); border-radius:24px; padding:24px; box-shadow:var(--glass-panel-shadow);">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; flex-wrap:wrap; gap:10px;">
          <div>
            <h2 style="font-size:18px; font-weight:900; color:#ffffff;">📜 Nhật Ký Truy Vết (Audit Log) &amp; Bộ Kiểm Thử Tự Động</h2>
            <div style="font-size:12px; color:var(--text-muted);">Ghi nhận toàn bộ dữ liệu tra cứu, kỹ năng gọi, quy tắc áp dụng và chạy đề thi mới</div>
          </div>
          <button class="run-pipeline-btn" style="width:auto; padding:8px 18px; font-size:12.5px; background:linear-gradient(135deg,#0284c7,#0369a1);" onclick="runAutomatedTestSuite()">
            🧪 Chạy Bộ Kiểm Thử Chuẩn (4 Kịch Bản)
          </button>
        </div>

        <!-- TEST RESULTS SCORECARD -->
        <div id="testSuiteScorecard" style="display:none; background:var(--card-inner-bg); border:1px solid var(--card-inner-border); border-radius:16px; padding:16px; margin-bottom:20px;">
          <div style="font-size:13px; font-weight:800; color:#ffffff; margin-bottom:8px;">📊 BẢNG TỔNG KẾT KẾT QUẢ KIỂM THỬ:</div>
          <div id="testScorecardContent" style="font-size:12px; color:var(--text-muted); line-height:1.5;"></div>
        </div>

        <div style="overflow-x:auto;">
          <table class="clean-table" id="auditLogsTable">
            <thead>
              <tr>
                <th>Thời Gian</th>
                <th>Mã Yêu Cầu</th>
                <th>Bước Xử Lý</th>
                <th>Skill Gọi</th>
                <th>Tool Sử Dụng</th>
                <th>Quy Tắc Áp Dụng</th>
                <th>Quyết Định</th>
                <th>Thời Gian (ms)</th>
              </tr>
            </thead>
            <tbody id="auditLogsBody">
              <!-- Dynamically populated from /api/audit-logs -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
      </div>
    </div>
  </div>

  <!-- MODAL POPUP XEM CHI TIẾT HỒ SƠ / EMAIL / PHIẾU DUYỆT -->
  <div id="dossierModal" class="modal-overlay" style="display:none;" onclick="if(event.target===this) closeDossierModal()">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-title">
          <span>📑</span>
          <span id="modalDossierTitle">Hồ sơ cơ hội bán hàng</span>
        </div>
        <button class="modal-close-btn" onclick="closeDossierModal()">✕</button>
      </div>

      <div class="modal-tabs">
        <button class="modal-tab-btn active" id="modalTabBtn-dossier" onclick="switchModalTab('dossier')">📄 Hồ Sơ Đầy Đủ (Markdown)</button>
        <button class="modal-tab-btn" id="modalTabBtn-email" onclick="switchModalTab('email')">✉️ Bản Nháp Email Phản Hồi</button>
        <button class="modal-tab-btn" id="modalTabBtn-ticket" onclick="switchModalTab('ticket')">👔 Phiếu Chuyển Phê Duyệt</button>
      </div>

      <div class="modal-body">
        <div id="modalBodyContent" style="white-space:pre-wrap; font-family:inherit; line-height:1.6; font-size:13px; color:#f1f5f9;"></div>
      </div>
    </div>
  </div>
  <div class="toast" id="toastBox"></div>

  <!-- =========================================================================
       3. JAVASCRIPT: LOGIC AGENT 6 BƯỚC, ANIMATION CÁNH HOA & THEME CONTROLS
       ========================================================================= -->
  <script>
    // MASTER DATA SẢN PHẨM CÔNG TY MINH AN
    const PRODUCTS = [
      { id: "PROD-001", name: "Laptop Dell Latitude 5540 (Core i7, 16GB, 512GB)", category: "Thiết bị đầu cuối", list_price: 25000000, available_stock: 20, ready_lead_time_days: 2, restock_lead_time_days: 14 },
      { id: "PROD-002", name: "Máy chủ HPE ProLiant DL380 Gen10 (Xeon Silver 4210R, 32GB)", category: "Máy chủ & Lưu trữ", list_price: 85000000, available_stock: 5, ready_lead_time_days: 3, restock_lead_time_days: 21 },
      { id: "PROD-003", name: "Cisco Catalyst Switch 24-Port Gigabit PoE (C9200L-24P-4G-E)", category: "Thiết bị mạng", list_price: 18000000, available_stock: 15, ready_lead_time_days: 2, restock_lead_time_days: 10 },
      { id: "PROD-004", name: "Bộ phát WiFi 6 Cisco Business 150AX Access Point", category: "Thiết bị mạng", list_price: 3500000, available_stock: 30, ready_lead_time_days: 1, restock_lead_time_days: 7 },
      { id: "PROD-005", name: "Dịch vụ Triển khai Cài đặt & Cấu hình Hệ thống (Gói Doanh nghiệp)", category: "Dịch vụ CNTT", list_price: 10000000, available_stock: 999, ready_lead_time_days: 3, restock_lead_time_days: 3 }
    ];

    // CHÍNH SÁCH KINH DOANH & ĐỘI NGŨ NVKD
    const POLICIES = {
      sales_reps: [
        { id: "SR01", name: "Nguyễn Văn An", email: "an.nv@minhan.com.vn", title: "Chuyên viên Kinh doanh Doanh nghiệp" },
        { id: "SR02", name: "Trần Thị Bình", email: "binh.tt@minhan.com.vn", title: "Chuyên viên Khách hàng Chiến lược" },
        { id: "SR03", name: "Lê Hoàng Cường", email: "cuong.lh@minhan.com.vn", title: "Chuyên viên Giải pháp Hạ tầng" },
        { id: "SR04", name: "Phạm Thu Dung", email: "dung.pt@minhan.com.vn", title: "Chuyên viên Giải pháp Thiết bị" },
        { id: "SR05", name: "Vũ Minh Đức", email: "duc.vm@minhan.com.vn", title: "Chuyên viên Kinh doanh B2B" },
        { id: "SR06", name: "Đặng Mai Phương", email: "phuong.dm@minhan.com.vn", title: "Chuyên viên Dịch vụ CNTT" }
      ],
      manager: { name: "Hoàng Minh Trí", role: "Trưởng phòng Kinh doanh", email: "tri.hm@minhan.com.vn" },
      volume_discount_policy: [
        { min_amount: 0, max_amount: 50000000, max_discount_rate: 0.00 },
        { min_amount: 50000000, max_amount: 100000000, max_discount_rate: 0.05 },
        { min_amount: 100000000, max_amount: 200000000, max_discount_rate: 0.08 },
        { min_amount: 200000000, max_amount: 999999999999, max_discount_rate: 0.10 }
      ],
      sales_rep_max_discount: 0.10,
      sales_rep_max_amount: 200000000,
      manager_max_discount: 0.15
    };

    // 4 KỊCH BẢN MẪU BÁM SÁT 4 NHÁNH QUYẾT ĐỊNH CỦA SƠ ĐỒ HÌNH 2
    const PRESET_SCENARIOS = [
      {
        id: "REQ-001",
        customer: "Công ty Cổ phần Công nghệ Sao Việt",
        email: "muasam@saoviet.com.vn",
        raw: "Kính gửi Công ty Minh An, chúng tôi cần mua 2 Máy chủ HPE DL380 Gen10 và 1 Cisco Catalyst Switch 24-Port. Đầy đủ ngân sách 200 triệu VND, chiết khấu hữu nghị 4% trong thẩm quyền NVKD. Thời hạn bàn giao là 10 ngày làm việc.",
        extracted: {
          items: [
            { product_id: "PROD-002", product_name: "Máy chủ HPE ProLiant DL380 Gen10", quantity: 2 },
            { product_id: "PROD-003", product_name: "Cisco Catalyst Switch 24-Port", quantity: 1 }
          ],
          budget: 200000000,
          deadline_days: 10,
          requested_discount_rate: 0.04
        }
      },
      {
        id: "REQ-002",
        customer: "Công ty Cổ phần Xây lắp Nam Hải",
        email: "contact@namhai-build.vn",
        raw: "Chào Minh An, bên anh cần hỏi mua máy chủ và switch mạng cho văn phòng chi nhánh mới. Báo giá nhanh nhé.",
        extracted: {
          items: [],
          budget: null,
          deadline_days: null,
          requested_discount_rate: 0.0
        }
      },
      {
        id: "REQ-003",
        customer: "Tập đoàn Đầu tư An Thịnh",
        email: "procurement@anthinhgroup.vn",
        raw: "Kính gửi Minh An, Tập đoàn An Thịnh cần đơn hàng lớn gồm 8 Máy chủ HPE DL380 Gen10 và 10 Switch Cisco 24-Port. Tổng ngân sách khoảng 800 triệu VND, đề nghị chiết khấu 10% và bàn giao trong 25 ngày.",
        extracted: {
          items: [
            { product_id: "PROD-002", product_name: "Máy chủ HPE ProLiant DL380 Gen10", quantity: 8 },
            { product_id: "PROD-003", product_name: "Cisco Catalyst Switch 24-Port", quantity: 10 }
          ],
          budget: 800000000,
          deadline_days: 25,
          requested_discount_rate: 0.10
        }
      },
      {
        id: "REQ-004",
        customer: "Ngân hàng Thương mại Cổ phần Việt Tín",
        email: "it-support@viettinbank.com.vn",
        raw: "Yêu cầu cung cấp gấp 8 Máy chủ HPE ProLiant DL380 Gen10 trong vòng 3 ngày để thay thế cụm server chi nhánh bị sự cố. Ngân sách 700 triệu VND.",
        extracted: {
          items: [
            { product_id: "PROD-002", product_name: "Máy chủ HPE ProLiant DL380 Gen10", quantity: 8 }
          ],
          budget: 700000000,
          deadline_days: 3,
          requested_discount_rate: 0.0
        }
      },
      {
        id: "REQ-005",
        customer: "Ngân hàng Thương mại Cổ phần Đông Á Bank",
        email: "cntt@dongabank.com.vn",
        raw: "Kính gửi Minh An, Đông Á Bank cần mua 3 Máy chủ HPE DL380 Gen10 và 2 Gói Dịch vụ Triển khai. Ngân sách 270 triệu VND, chiết khấu hữu nghị 7%, thời hạn bàn giao 15 ngày.",
        extracted: {
          items: [
            { product_id: "PROD-002", product_name: "Máy chủ HPE ProLiant DL380 Gen10", quantity: 3 },
            { product_id: "PROD-005", product_name: "Gói Dịch vụ Triển khai Cài đặt", quantity: 2 }
          ],
          budget: 270000000,
          deadline_days: 15,
          requested_discount_rate: 0.07
        }
      }
    ];

    let currentScenarioIdx = 0;
    let currentProcessedResult = null;

    function formatVND(amount) {
      if (typeof amount !== "number" || isNaN(amount)) return "0 VND";
      return amount.toLocaleString("vi-VN") + " VND";
    }

    function showToast(msg) {
      const box = document.getElementById("toastBox");
      if (!box) return;
      box.textContent = msg;
      box.style.display = "block";
      setTimeout(() => { box.style.display = "none"; }, 3200);
    }

    // TẠO CÁNH HOA ANH ĐÀO RƠI TỰ NHIÊN (SAKURA DRIFT)
    function createFallingPetals(count = 25) {
      const container = document.getElementById("sakuraPetalsContainer");
      if (!container) return;
      container.innerHTML = "";
      for (let i = 0; i < count; i++) {
        const petal = document.createElement("div");
        petal.className = "petal";
        const sizeW = Math.random() * 8 + 10;
        const sizeH = sizeW * (Math.random() * 0.4 + 1.2);
        const startX = Math.random() * 100;
        const driftX = (Math.random() - 0.3) * 180;
        const duration = Math.random() * 8 + 12; // 12-20s rơi chậm nhẹ nhàng
        const delay = Math.random() * 12;
        const rot = Math.random() * 360 + 180;

        petal.style.width = `${sizeW}px`;
        petal.style.height = `${sizeH}px`;
        petal.style.left = `${startX}vw`;
        petal.style.setProperty("--drift-x", `${driftX}px`);
        petal.style.setProperty("--rot", `${rot}deg`);
        petal.style.animationDuration = `${duration}s`;
        petal.style.animationDelay = `${delay}s`;
        petal.style.opacity = (Math.random() * 0.35 + 0.55).toString();

        container.appendChild(petal);
      }
    }

    function toggleTreeBranch() {
      const svg = document.getElementById("sakuraBranchSvg");
      if (!svg) return;
      const isHidden = svg.style.display === "none";
      svg.style.display = isHidden ? "block" : "none";
      showToast(isHidden ? "🌸 Đã hiển thị Cành Đào nền" : "🪵 Đã tạm ẩn Cành Đào nền");
    }

    function togglePetals() {
      const container = document.getElementById("sakuraPetalsContainer");
      if (!container) return;
      const isHidden = container.style.display === "none";
      container.style.display = isHidden ? "block" : "none";
      showToast(isHidden ? "🌸 Đã hiển thị cánh hoa anh đào rơi" : "🍃 Đã tạm ẩn cánh hoa");
    }

    function setPetalsSpeed(speed) {
      createFallingPetals(speed === 'slow' ? 22 : 35);
      showToast("🍃 Đã điều chỉnh cánh hoa rơi êm dịu");
    }

    // CHỌN KỊCH BẢN 1-CLICK
    function pickScenario(idx, cardEl) {
      currentScenarioIdx = idx;
      document.querySelectorAll(".scenario-card").forEach((c, i) => {
        c.classList.toggle("active", i === idx);
      });
      const sc = PRESET_SCENARIOS[idx];
      const textarea = document.getElementById("liveInquiryText");
      if (textarea && sc) {
        textarea.value = sc.raw;
      }
      showToast(`✨ Đã chọn Kịch bản ${idx + 1}: ${sc.customer}`);
    }

    // THỰC THI AI AGENT PIPELINE THEO ĐÚNG 6 BƯỚC SƠ ĐỒ HÌNH 2
    function executeCurrentInquiry() {
      const rawText = document.getElementById("liveInquiryText").value;
      const sc = PRESET_SCENARIOS[currentScenarioIdx] || PRESET_SCENARIOS[0];
      const rep = POLICIES.sales_reps[currentScenarioIdx % POLICIES.sales_reps.length];
      const trace = [];

      // BƯỚC 1: TIẾP NHẬN - PHÂN TÍCH - XÁC THỰC YÊU CẦU (AI Agent + Tool)
      trace.push({
        step: "Bước 1: Tiếp nhận - Phân tích - Xác thực yêu cầu",
        tool: "AI Agent + Tool chuẩn hóa",
        thought: "Đọc nội dung văn bản, trích xuất thông tin thực thể, kiểm tra trùng lặp và gán mã cơ hội.",
        decision: `Đã cấp phát mã cơ hội [${sc.id}], gán NVKD thụ lý: ${rep.name}.`
      });

      // BƯỚC 2: PHÂN TÍCH YÊU CẦU KHÁCH HÀNG (Skill: requirement_analysis)
      const hasMissingInfo = !sc.extracted.budget || !sc.extracted.deadline_days || sc.extracted.items.length === 0;

      trace.push({
        step: "Bước 2: Phân tích yêu cầu khách hàng",
        tool: "Skill: requirement_analysis",
        thought: "Liệt kê sản phẩm, số lượng, ngân sách dự kiến, thời hạn hoàn thành và rà soát thông tin thiếu.",
        decision: hasMissingInfo ? "❌ THIẾU THÔNG TIN: Yêu cầu thiếu danh mục sản phẩm, ngân sách hoặc thời hạn." : "✅ ĐẦY ĐỦ VÀ HỢP LỆ: Đủ 5 tiêu chí để chuyển tiếp sang Bước 3."
      });

      if (hasMissingInfo) {
        // Nhánh KHÔNG: Yêu cầu bổ sung thông tin
        currentProcessedResult = {
          id: sc.id,
          customer: sc.customer,
          email: sc.email,
          raw: rawText,
          status: "Cần bổ sung thông tin",
          rep: rep,
          listPrice: 0,
          discountRate: 0,
          finalTotal: 0,
          items: [],
          draftEmail: `Kính gửi Quý khách hàng ${sc.customer},\n\nCông ty TNHH Tin học Minh An xin gửi lời chào trân trọng.\n\nChúng tôi đã tiếp nhận yêu cầu mua sắm thiết bị CNTT của Quý khách. Tuy nhiên, sau khi hệ thống AI rà soát, hồ sơ hiện còn thiếu các thông số kỹ thuật bắt buộc sau:\n1. Số lượng & danh mục cấu hình thiết bị chi tiết\n2. Ngân sách dự kiến của đơn hàng\n3. Thời hạn giao hàng và địa điểm triển khai mong muốn\n\nKính đề nghị Quý khách phản hồi thông tin trên để chuyên viên phụ trách (${rep.name} - ${rep.email}) có thể hoàn thiện bảng báo giá chính xác nhất trong vòng 4 giờ.\n\nTrân trọng,\nCông ty TNHH Tin học Minh An`,
          approvalTicket: null,
          dossierContent: `HỒ SƠ CƠ HỘI BÁN HÀNG B2B - MINH AN COMPANY\n------------------------------------------------------------\nMã cơ hội: ${sc.id}\nKhách hàng: ${sc.customer}\nEmail liên hệ: ${sc.email}\nNVKD phụ trách: ${rep.name} (${rep.email})\nTrạng thái: CẦN BỔ SUNG THÔNG TIN\nLý do phân loại: Thiếu các trường bắt buộc (Danh mục BoQ, ngân sách, deadline).\nHành động tiếp theo: Đã tạo bản nháp email yêu cầu khách hàng làm rõ.`,
          trace: trace,
          feasible: false,
          stockReport: "Chưa thể đối chiếu kho do chưa có danh mục sản phẩm cụ thể."
        };
      } else {
        // BƯỚC 3: ĐỐI CHIẾU DỮ LIỆU KINH DOANH (Tool: Tra cứu dữ liệu)
        let maxLeadTime = 0;
        let stockAllOk = true;
        let listTotal = 0;

        const enrichedItems = sc.extracted.items.map(it => {
          const prod = PRODUCTS.find(p => p.id === it.product_id) || PRODUCTS[0];
          const stockOk = prod.available_stock >= it.quantity;
          if (!stockOk) stockAllOk = false;
          const lead = stockOk ? prod.ready_lead_time_days : prod.restock_lead_time_days;
          if (lead > maxLeadTime) maxLeadTime = lead;
          const lineTotal = prod.list_price * it.quantity;
          listTotal += lineTotal;
          return {
            name: prod.name,
            qty: it.quantity,
            price: prod.list_price,
            lineTotal: lineTotal,
            stockOk: stockOk,
            stockVal: prod.available_stock,
            lead: lead
          };
        });

        trace.push({
          step: "Bước 3: Đối chiếu dữ liệu kinh doanh",
          tool: "Tool: Tra cứu dữ liệu (Kho & Bảng giá)",
          thought: `Tra cứu danh mục ${enrichedItems.length} sản phẩm, tồn kho khả dụng ATP và bảng giá niêm yết mới nhất.`,
          decision: `Đã đối chiếu bảng giá niêm yết: Tổng ${formatVND(listTotal)}. Tồn kho ATP ghi nhận, Lead time cần thiết: ${maxLeadTime} ngày.`
        });

        // BƯỚC 4: ĐÁNH GIÁ KHẢ NĂNG ĐÁP ỨNG (Skill: opportunity_evaluation)
        const leadTimeMet = sc.extracted.deadline_days >= maxLeadTime;
        const discountRate = sc.extracted.requested_discount_rate || 0.0;
        const discountAmount = listTotal * discountRate;
        const finalTotal = listTotal - discountAmount;

        const exceedDiscount = discountRate > POLICIES.sales_rep_max_discount;
        const exceedAmount = listTotal > POLICIES.sales_rep_max_amount;
        const isManagerExceed = listTotal > 500000000 || discountRate > POLICIES.manager_max_discount;
        const needsApproval = exceedDiscount || exceedAmount;

        let finalStatus = "Có thể tiếp tục";
        let approvalTicket = null;

        if (!leadTimeMet) {
          finalStatus = "Chưa đáp ứng";
          trace.push({
            step: "Bước 4: Đánh giá khả năng đáp ứng",
            tool: "Skill: opportunity_evaluation",
            thought: `So sánh hạn chót KH (${sc.extracted.deadline_days} ngày) với Lead time cung ứng (${maxLeadTime} ngày).`,
            decision: "❌ KHÔNG ĐÁP ỨNG TIẾN ĐỘ: Hạn chót của khách gấp hơn thời gian đặt hàng từ hãng &rarr; Đề xuất phương án thay thế."
          });
        } else if (needsApproval) {
          finalStatus = "Chờ duyệt";
          trace.push({
            step: "Bước 4: Đánh giá khả năng đáp ứng & Thẩm quyền",
            tool: "Skill: opportunity_evaluation",
            thought: `Tính chiết khấu ${(discountRate*100).toFixed(1)}%, giá trị sau CK: ${formatVND(finalTotal)}. Kiểm tra quyền phê duyệt.`,
            decision: isManagerExceed ? "⚠️ VƯỢT QUYỀN TRƯỞNG PHÒNG (>200M/15%): Chuyển cấp cao hơn (Gửi đề xuất Ban Giám đốc)." : "⚠️ VƯỢT QUYỀN NVKD (≤ 200M/10%): Tạo phiếu chuyển duyệt cho Trưởng phòng."
          });

          approvalTicket = `PHIẾU CHUYỂN DUYỆT CƠ HỘI BÁN HÀNG B2B\n` +
            `------------------------------------------------------------\n` +
            `Kính gửi: ${isManagerExceed ? 'Ban Giám Đốc Công ty Minh An' : 'Ông ' + POLICIES.manager.name + ' - ' + POLICIES.manager.role}\n` +
            `NVKD đề xuất: ${rep.name} (${rep.id}) - ${rep.title}\n` +
            `Mã hồ sơ: ${sc.id} | Khách hàng: ${sc.customer}\n` +
            `Tổng giá trị niêm yết: ${formatVND(listTotal)}\n` +
            `Mức chiết khấu đề xuất: ${(discountRate*100).toFixed(1)}% (Tương đương ${formatVND(discountAmount)})\n` +
            `Giá trị thanh toán đề xuất: ${formatVND(finalTotal)}\n\n` +
            `LÝ DO CẦN DUYỆT CẤP CAO HƠN:\n` +
            `${exceedDiscount ? "- Chiết khấu xin vượt hạn mức tiêu chuẩn của NVKD (10%).\n" : ""}` +
            `${exceedAmount ? "- Tổng giá trị đơn hàng (" + formatVND(listTotal) + ") vượt hạn mức tự quyết 200 triệu VND.\n" : ""}` +
            `${isManagerExceed ? "- Đơn hàng quy mô lớn cần ý kiến chỉ đạo trực tiếp từ Ban Giám đốc.\n" : ""}\n` +
            `Ý KIẾN ĐỀ XUẤT CỦA NVKD:\n` +
            `Khách hàng là đối tác chiến lược có khả năng mở rộng hợp đồng trong Quý tới, kính trình Cấp thẩm quyền xem xét phê duyệt.`;
        } else {
          trace.push({
            step: "Bước 4: Đánh giá khả năng đáp ứng",
            tool: "Skill: opportunity_evaluation",
            thought: `Thẩm định khả thi về mặt kỹ thuật, tiến độ giao hàng và tỷ lệ chiết khấu ${(discountRate*100).toFixed(1)}%.`,
            decision: "✅ ĐỦ ĐIỀU KIỆN TIẾP TỤC: Trong thẩm quyền tự quyết của NVKD, đáp ứng 100% BoQ và tiến độ."
          });
        }

        // BƯỚC 5: TẠO HỒ SƠ VÀ PHẢN HỒI (Skill: sales_document_generator)
        trace.push({
          step: "Bước 5: Tạo hồ sơ và phản hồi",
          tool: "Skill: sales_document_generator",
          thought: "Tạo hồ sơ cơ hội bán hàng hoàn chỉnh, bản nháp email phản hồi khách hàng và phiếu chuyển duyệt (nếu cần).",
          decision: `Đã hoàn tất sinh bộ tài liệu chuẩn B2B. Trạng thái phân loại: [${finalStatus}].`
        });

        // BƯỚC 6: KIỂM TRA CHÉO VÀ GHI NHẬT KÝ (Tool: Logging)
        trace.push({
          step: "Bước 6: Kiểm tra chéo và ghi nhật ký",
          tool: "Tool: Logging",
          thought: "Rà soát toàn bộ kết quả, đối chiếu công thức chiết khấu và ghi nhận log thực thi vào hệ thống.",
          decision: "Bàn giao hồ sơ thành công cho NVKD và Trưởng phòng thụ lý."
        });

        currentProcessedResult = {
          id: sc.id,
          customer: sc.customer,
          email: sc.email,
          raw: rawText,
          status: finalStatus,
          rep: rep,
          listPrice: listTotal,
          discountRate: discountRate,
          finalTotal: finalTotal,
          items: enrichedItems,
          draftEmail: `Kính gửi Quý khách hàng ${sc.customer},\n\nCông ty TNHH Tin học Minh An xin gửi lời cảm ơn chân thành đến Quý khách đã tin tưởng lựa chọn giải pháp của chúng tôi.\n\nSau khi rà soát tồn kho và thẩm định kỹ thuật, Minh An xin trân trọng thông báo phương án cung ứng như sau:\n- Danh mục BoQ: Đã tích hợp đầy đủ thiết bị chính hãng, giấy phép bản quyền và gói phụ kiện tiêu chuẩn 100%.\n- Tổng giá trị đơn hàng sau chiết khấu (${(discountRate*100).toFixed(1)}%): ${formatVND(finalTotal)}\n- Thời gian bàn giao dự kiến: ${maxLeadTime} ngày làm việc kể từ ngày ký kết hợp đồng.\n- Trạng thái xử lý: ${finalStatus === 'Chưa đáp ứng' ? 'Cần điều chỉnh thời hạn hoặc cấu hình tương đương' : 'Đủ điều kiện triển khai'}\n\nChuyên viên phụ trách ${rep.name} (${rep.email} - ĐT: 028.3822.xxxx) sẽ liên hệ trực tiếp với Quý khách trong vòng 4 giờ để thống nhất các điều khoản chi tiết.\n\nTrân trọng,\nCông ty TNHH Tin học Minh An`,
          approvalTicket: approvalTicket,
          dossierContent: `HỒ SƠ CƠ HỘI BÁN HÀNG B2B - CÔNG TY MINH AN\n` +
            `============================================================\n` +
            `Mã cơ hội: ${sc.id}\n` +
            `Khách hàng: ${sc.customer}\n` +
            `Email: ${sc.email}\n` +
            `Chuyên viên NVKD: ${rep.name} (${rep.id}) - ${rep.email}\n` +
            `Trạng thái: ${finalStatus.toUpperCase()}\n` +
            `Tổng giá trị niêm yết: ${formatVND(listTotal)}\n` +
            `Chiết khấu đề xuất: ${(discountRate*100).toFixed(1)}% (${formatVND(discountAmount)})\n` +
            `Giá trị đề xuất cuối: ${formatVND(finalTotal)}\n` +
            `Thời gian cam kết giao: ${maxLeadTime} ngày (Hạn chót KH: ${sc.extracted.deadline_days} ngày)\n` +
            `------------------------------------------------------------\n` +
            `DANH MỤC HẠNG MỤC BOQ (ĐÃ CHUẨN HÓA 100%):\n` +
            enrichedItems.map((it, idx) => `${idx + 1}. ${it.name} | SL: ${it.qty} | Đơn giá: ${formatVND(it.price)} | Thành tiền: ${formatVND(it.lineTotal)}`).join('\n'),
          trace: trace,
          feasible: leadTimeMet,
          maxLeadTime: maxLeadTime,
          deadlineDays: sc.extracted.deadline_days
        };
      }

      // HIỂN THỊ KẾT QUẢ SANG CỘT PHẢI
      renderInspectorResult();
      showToast(`🚀 Đã hoàn tất xử lý 6 bước cho ${sc.customer}!`);
    }

    function renderInspectorResult() {
      const res = currentProcessedResult;
      if (!res) return;

      document.getElementById("inspectorEmptyState").style.display = "none";
      document.getElementById("inspectorFilledState").style.display = "block";

      document.getElementById("inspCustomerTitle").textContent = `${res.id} — ${res.customer}`;
      document.getElementById("inspCustomerSub").textContent = `NVKD: ${res.rep.name} (${res.rep.email}) • Email KH: ${res.email}`;
      
      const statusBadge = document.getElementById("inspStatusBadge");
      const badgeClassMap = {
        "Có thể tiếp tục": "st-ready",
        "Cần bổ sung thông tin": "st-need",
        "Chưa đáp ứng": "st-unfulfill",
        "Chờ duyệt": "st-pending"
      };
      statusBadge.innerHTML = `<span class="st-badge ${badgeClassMap[res.status] || ''}">● ${res.status}</span>`;

      // Raw text
      document.getElementById("inspRawText").textContent = res.raw;

      // Table items
      if (res.items.length > 0) {
        document.getElementById("inspItemsTable").innerHTML = `
          <table class="clean-table">
            <thead>
              <tr><th>Thiết bị</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th><th>Tồn ATP</th><th>Lead time</th></tr>
            </thead>
            <tbody>
              ${res.items.map(it => `
                <tr>
                  <td><strong>${it.name}</strong></td>
                  <td>${it.qty}</td>
                  <td>${formatVND(it.price)}</td>
                  <td>${formatVND(it.lineTotal)}</td>
                  <td><span class="${it.stockOk ? 'kpi-tag-green' : 'kpi-tag-blue'}">${it.stockOk ? 'Đủ kho (' + it.stockVal + ')' : 'Nhập thêm (' + it.stockVal + ')'}</span></td>
                  <td>${it.lead} ngày</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
      } else {
        document.getElementById("inspItemsTable").innerHTML = `<div style="font-size:12px; color:var(--text-muted); font-style:italic;">Chưa có danh mục thiết bị bóc tách (do yêu cầu thiếu thông tin).</div>`;
      }

      document.getElementById("inspListPrice").textContent = formatVND(res.listPrice);
      document.getElementById("inspDiscountRate").textContent = (res.discountRate * 100).toFixed(1) + "%";
      document.getElementById("inspFinalTotal").textContent = res.finalTotal > 0 ? formatVND(res.finalTotal) : "Chưa định giá";

      // HITL buttons
      const hitlDiv = document.getElementById("inspHitlButtons");
      if (res.status === "Chờ duyệt") {
        hitlDiv.innerHTML = `
          <button class="run-pipeline-btn" style="padding:8px 16px; font-size:12px; background:linear-gradient(135deg,#9333ea,#7e22ce);" onclick="showToast('✅ Trưởng phòng Hoàng Minh Trí đã phê duyệt ngoại lệ!')">
            👔 Trưởng phòng Duyệt
          </button>
        `;
      } else if (res.status === "Có thể tiếp tục") {
        hitlDiv.innerHTML = `
          <button class="run-pipeline-btn" style="padding:8px 16px; font-size:12px; background:linear-gradient(135deg,#16a34a,#15803d);" onclick="showToast('✅ NVKD đã xác nhận gửi bản nháp báo giá!')">
            ✉️ NVKD Gửi Báo Giá
          </button>
        `;
      } else {
        hitlDiv.innerHTML = `
          <button class="run-pipeline-btn" style="padding:8px 16px; font-size:12px; background:linear-gradient(135deg,#ea580c,#c2410c);" onclick="showToast('✉️ Đã gửi thư làm rõ / đàm phán phương án!')">
            ✉️ Gửi Phản Hồi
          </button>
        `;
      }

      // Dossier
      document.getElementById("inspDossierContent").textContent = res.dossierContent || "Chưa khởi tạo hồ sơ.";

      // Email draft
      document.getElementById("inspEmailContent").textContent = res.draftEmail;

      // Ticket
      document.getElementById("inspTicketContent").textContent = res.approvalTicket || "Hồ sơ này nằm trong thẩm quyền tự quyết của NVKD hoặc chưa đủ điều kiện lập phiếu chuyển duyệt.";

      // Trace
      document.getElementById("inspTraceContent").innerHTML = res.trace.map(t => `
        <div style="background:var(--card-inner-bg); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); border:1px solid var(--card-inner-border); border-radius:12px; padding:10px 14px; font-size:12px; box-shadow:var(--card-inner-shadow);">
          <div style="display:flex; justify-content:space-between; font-weight:800; margin-bottom:4px;">
            <span style="color:#ffffff;">${t.step}</span>
            <span style="color:#fb7185;">${t.tool}</span>
          </div>
          <div style="color:var(--text-muted); margin-bottom:2px;">💭 ${t.thought}</div>
          <div style="font-weight:700; color:#ffffff;">🎯 ${t.decision}</div>
        </div>
      `).join('');

      // Stock content
      document.getElementById("inspStockContent").innerHTML = `
        <div style="background:var(--card-inner-bg); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); border:1px solid var(--card-inner-border); border-radius:14px; padding:16px; font-size:12.5px; line-height:1.6; color:#ffffff; box-shadow:var(--card-inner-shadow);">
          <strong>Báo cáo thẩm định tồn kho &amp; tiến độ:</strong>
          <div style="margin-top:6px;">• Khách yêu cầu giao: <strong>${res.deadlineDays ? res.deadlineDays + ' ngày' : 'Chưa cung cấp'}</strong></div>
          <div>• Thời gian Minh An đáp ứng: <strong>${res.maxLeadTime ? res.maxLeadTime + ' ngày' : 'N/A'}</strong></div>
          <div>• Đánh giá: <strong>${res.feasible ? 'Khả thi tiến độ' : 'Cảnh báo rủi ro vi phạm tiến độ'}</strong></div>
        </div>
      `;

      // Update horizontal stepper state
      updateHorizontalStepper(res.status);
    }

    function updateHorizontalStepper(status) {
      const stepper = document.getElementById("mainPipelineStepper");
      if (!stepper) return;
      const steps = stepper.querySelectorAll(".step-box");
      steps.forEach(s => s.classList.remove("active", "warn"));

      if (status === "Cần bổ sung thông tin") {
        steps[0].classList.add("active");
        steps[1].classList.add("active");
        steps[2].classList.add("warn");
      } else if (status === "Chờ duyệt") {
        steps[0].classList.add("active");
        steps[1].classList.add("active");
        steps[3].classList.add("active");
        steps[4].classList.add("active");
        steps[6].classList.add("warn");
      } else if (status === "Có thể tiếp tục") {
        steps.forEach(s => s.classList.add("active"));
      } else {
        steps[0].classList.add("active");
        steps[1].classList.add("active");
        steps[4].classList.add("warn");
      }
    }

    function switchInspSubTab(paneId, btnEl) {
      document.querySelectorAll(".insp-pane").forEach(p => p.classList.remove("active"));
      document.getElementById(paneId).classList.add("active");
      document.querySelectorAll(".insp-tab").forEach(b => b.classList.remove("active"));
      if (btnEl) btnEl.classList.add("active");
    }

    // ĐIỀU HƯỚNG VIEW TRONG SIDEBAR
    function switchNavView(viewId, btnEl) {
      document.querySelectorAll(".main-tab-view").forEach(v => v.style.display = "none");
      const target = document.getElementById(viewId);
      if (target) target.style.display = "block";

      // Sync active state across old sidebar, Steary mini dock, and top pill tabs
      document.querySelectorAll(".sidebar-nav .nav-btn, .steary-dock-btn, .steary-tab-pill").forEach(b => b.classList.remove("active"));
      
      const shortId = viewId.replace('view-', '');
      const dockBtn = document.getElementById(`dockBtn-${shortId}`);
      if (dockBtn) dockBtn.classList.add("active");
      const pillTab = document.getElementById(`pillTab-${shortId}`);
      if (pillTab) pillTab.classList.add("active");
      if (btnEl) btnEl.classList.add("active");

      // Auto-load data from API based on active view
      if (viewId === 'view-pipeline') fetchDashboardData();
      else if (viewId === 'view-dossiers') fetchAndRenderDossiers();
      else if (viewId === 'view-approvals') fetchAndRenderApprovals();
      else if (viewId === 'view-audit') fetchAndRenderAuditLogs();
    }

    // GLASS CONTROLS & THEME
    function toggleGlassControls() {
      const panel = document.getElementById("glassControlsPanel");
      if (!panel) return;
      panel.style.display = panel.style.display === "none" ? "block" : "none";
    }

    function setThemeStyle(theme) {
      document.body.setAttribute("data-theme", theme);
      document.querySelectorAll(".theme-buttons-row .theme-btn").forEach(b => {
        b.classList.toggle("active", b.id === `btn-theme-${theme}`);
      });
      localStorage.setItem("minhan_theme", theme);
      showToast(`🎨 Đã đổi bảng màu kính: ${theme.toUpperCase()}`);
    }

    function setModeStyle(mode) {
      document.body.setAttribute("data-mode", mode);
      document.getElementById("btn-mode-light").classList.toggle("active", mode === "light");
      document.getElementById("btn-mode-dark").classList.toggle("active", mode === "dark");
      localStorage.setItem("minhan_mode", mode);
      showToast(`☀️/🌙 Đã chuyển độ sáng kính: ${mode === 'dark' ? 'Mận Nhung Tối' : 'Pha Lê Sáng'}`);
    }

    // LOAD FAST EXAM DATASET
    async function loadDataset(type) {
      showToast('⚡ Đang nạp nhanh bộ đề thi mẫu chuẩn AI301...');
      await runAutomatedTestSuite();
      switchNavView('view-dossiers');
    }

    function refreshDashboard() {
      pickScenario(0); 
      if (typeof pickStearyScenario === 'function') pickStearyScenario(0);
      fetchDashboardData(); 
      fetchAndRenderDossiers(); 
      fetchAndRenderApprovals(); 
      initYuriHoverEvents();
      showToast("🔄 Đã làm mới số liệu Dashboard.");
    }

    // INIT DỮ LIỆU CÁC VIEW PHỤ
    function initAuxiliaryViews() {
      // 1. Sales rep cards
      const salesGrid = document.getElementById("salesRepsGrid");
      if (salesGrid) {
        salesGrid.innerHTML = POLICIES.sales_reps.map(r => `
          <div style="background:var(--card-inner-bg); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); border:1px solid var(--card-inner-border); border-radius:16px; padding:16px; box-shadow:var(--card-inner-shadow);">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
              <div style="width:36px; height:36px; border-radius:50%; background:#f43f5e; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:13px;">${r.id}</div>
              <div>
                <strong style="font-size:13.5px; display:block; color:#ffffff;">${r.name}</strong>
                <span style="font-size:11px; color:var(--text-muted);">${r.email}</span>
              </div>
            </div>
            <div style="font-size:11.5px; color:var(--text-muted);">${r.title}</div>
            <div style="margin-top:10px; font-size:11px; font-weight:700; color:#4ade80;">● Đang phụ trách: 2-3 cơ hội</div>
          </div>
        `).join('');
      }

      // 2. Catalog table
      const catalogBody = document.getElementById("masterCatalogBody");
      if (catalogBody) {
        catalogBody.innerHTML = PRODUCTS.map(p => `
          <tr>
            <td><strong style="color:#ffffff;">${p.id}</strong></td>
            <td><strong style="color:#ffffff;">${p.name}</strong></td>
            <td style="color:var(--text-muted);">${p.category}</td>
            <td style="color:#fb7185; font-weight:800;">${formatVND(p.list_price)}</td>
            <td><span class="kpi-tag-green">${p.available_stock} có sẵn</span></td>
            <td style="color:#ffffff;">${p.ready_lead_time_days} ngày</td>
            <td style="color:#ffffff;">${p.restock_lead_time_days} ngày</td>
          </tr>
        `).join('');
      }

      // 3. Inventory rules
      const invRules = document.getElementById("inventoryRulesCards");
      if (invRules) {
        invRules.innerHTML = PRODUCTS.map(p => `
          <div style="background:var(--card-inner-bg); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); border:1px solid var(--card-inner-border); border-radius:14px; padding:14px; box-shadow:var(--card-inner-shadow);">
            <div style="font-weight:800; font-size:13px; margin-bottom:4px; color:#ffffff;">${p.name}</div>
            <div style="font-size:11.5px; color:var(--text-muted);">Tồn kho sẵn có: <strong style="color:#ffffff;">${p.available_stock} đơn vị</strong></div>
            <div style="font-size:11.5px; color:var(--text-muted);">SLA giao ngay: <strong style="color:#4ade80;">${p.ready_lead_time_days} ngày</strong> • Nhập hàng: <strong style="color:#fb7185;">${p.restock_lead_time_days} ngày</strong></div>
          </div>
        `).join('');
      }
    }

    // INIT KHI TẢI TRANG
    window.addEventListener("DOMContentLoaded", () => {
      const savedTheme = "steary";
      const savedMode = localStorage.getItem("minhan_mode") || "light";
      document.body.setAttribute("data-theme", savedTheme);
      document.body.setAttribute("data-mode", savedMode);

      setThemeStyle(savedTheme);
      setModeStyle(savedMode);

      createFallingPetals(25);
      initAuxiliaryViews();
      pickScenario(0); 
      if (typeof pickStearyScenario === 'function') pickStearyScenario(0);
      fetchDashboardData(); 
      fetchAndRenderDossiers(); 
      fetchAndRenderApprovals(); 
      initYuriHoverEvents();
    });
    // =========================================================================
    // REST API CLIENT & STATE MANAGEMENT FOR MINH AN B2B AGENT
    // =========================================================================
    let CACHED_OPPORTUNITIES = [];
    let CACHED_APPROVALS = [];
    let ACTIVE_MODAL_OPP = null;
    let ACTIVE_MODAL_TAB = 'dossier';

    // 1. REFRESH DASHBOARD STATS FROM BACKEND API
    async function fetchDashboardData() {
      try {
        const res = await fetch('/api/dashboard');
        if (!res.ok) return;
        const data = await res.json();

        // Bind Bento Cards
        const elTotal = document.getElementById('kpiTotalLeads');
        if (elTotal) elTotal.innerText = `${data.total_inquiries} Leads`;

        const elEligible = document.getElementById('kpiEligibleVal');
        if (elEligible) elEligible.innerText = formatVND(data.total_eligible_value || 0);

        const elEligibleCnt = document.getElementById('kpiEligibleCount');
        if (elEligibleCnt) elEligibleCnt.innerText = `${data.status_counts['Có thể tiếp tục'] || 0} Cơ hội`;

        const elPending = document.getElementById('kpiPendingVal');
        if (elPending) elPending.innerText = formatVND(data.total_pending_approval_value || 0);

        const elPendingCnt = document.getElementById('kpiPendingCount');
        if (elPendingCnt) elPendingCnt.innerText = `${data.status_counts['Chờ duyệt'] || 0} Cơ hội`;

        const elOther = document.getElementById('kpiOtherVal');
        if (elOther) {
          const bs = data.status_counts['Cần bổ sung'] || 0;
          const cd = data.status_counts['Chưa đáp ứng'] || 0;
          elOther.innerText = `${bs} BS • ${cd} Chưa ĐƯ`;
        }

        const badgePending = document.getElementById('badgePendingCount');
        if (badgePending) {
          const pCnt = data.status_counts['Chờ duyệt'] || 0;
          badgePending.innerText = `${pCnt} Đơn`;
        }
      } catch (err) {
        console.warn('Backend API not responding, using offline cached data', err);
      }
    }

    // 2. FETCH & RENDER DOSSIERS TABLE
    async function fetchAndRenderDossiers(filterStatus = 'all') {
      try {
        const res = await fetch('/api/opportunities');
        if (!res.ok) return;
        CACHED_OPPORTUNITIES = await res.json();
        renderDossiersTable(filterStatus);
      } catch (err) {
        console.error('Error fetching opportunities:', err);
      }
    }

    function renderDossiersTable(filterStatus = 'all') {
      const tbody = document.getElementById('allDossiersBody');
      if (!tbody) return;

      const list = CACHED_OPPORTUNITIES.filter(o => {
        if (filterStatus === 'all') return true;
        return o.status === filterStatus;
      });

      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; color:var(--text-muted); padding:20px;">Không có hồ sơ nào phù hợp bộ lọc.</td></tr>';
        return;
      }

      tbody.innerHTML = list.map(opp => {
        let badgeClass = 'badge-continue';
        if (opp.status === 'Chờ duyệt') badgeClass = 'badge-pending';
        else if (opp.status === 'Cần bổ sung') badgeClass = 'badge-supplement';
        else if (opp.status === 'Chưa đáp ứng') badgeClass = 'badge-rejected';

        const repName = opp.assigned_rep ? opp.assigned_rep.name : 'NVKD';
        const discStr = opp.applied_discount_rate ? `${(opp.applied_discount_rate * 100).toFixed(1)}%` : '0%';
        const leadStr = opp.max_lead_time_days ? `${opp.max_lead_time_days} ngày` : 'N/A';

        return `
          <tr>
            <td><strong style="color:#ffffff;">${opp.inquiry_id}</strong></td>
            <td><strong style="color:#ffffff;">${opp.customer_name}</strong><br><span style="font-size:11px; color:var(--text-muted);">${opp.contact_email}</span></td>
            <td><span class="status-badge-pill ${badgeClass}">● ${opp.status}</span></td>
            <td style="color:#fb7185; font-weight:800;">${formatVND(opp.final_total || 0)}</td>
            <td style="color:#ffffff;">${discStr}</td>
            <td style="color:#ffffff;">${leadStr}</td>
            <td style="color:#ffffff;">${repName}</td>
            <td>
              <button class="glass-controls-btn" style="padding:4px 10px; font-size:11px;" onclick="openDossierModal('${opp.inquiry_id}')">
                🔍 Xem Chi Tiết
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    function filterDossiers(status) {
      renderDossiersTable(status);
    }

    // 3. FETCH & RENDER PENDING APPROVALS (HITL)
    async function fetchAndRenderApprovals() {
      try {
        const res = await fetch('/api/approvals');
        if (!res.ok) return;
        const data = await res.json();
        CACHED_APPROVALS = data.pending_opportunities || [];

        const container = document.getElementById('pendingApprovalsContainer');
        if (container) {
          if (CACHED_APPROVALS.length === 0) {
            container.innerHTML = '<div style="padding:20px; text-align:center; color:var(--text-muted); background:var(--card-inner-bg); border-radius:14px;">Không có hồ sơ nào đang chờ duyệt.</div>';
          } else {
            container.innerHTML = CACHED_APPROVALS.map(opp => `
              <div style="background:var(--card-inner-bg); border:1px solid rgba(250,204,21,0.4); border-radius:18px; padding:20px; box-shadow:var(--card-inner-shadow);">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:12px; flex-wrap:wrap; gap:8px;">
                  <div>
                    <span class="status-badge-pill badge-pending" style="margin-bottom:6px;">⚠️ CẦN PHÊ DUYỆT NGOẠI LỆ</span>
                    <h3 style="font-size:16px; font-weight:800; color:#ffffff; margin:4px 0;">${opp.inquiry_id} — ${opp.customer_name}</h3>
                    <div style="font-size:11.5px; color:var(--text-muted);">Email: ${opp.contact_email} • NVKD đề xuất: <strong style="color:#ffffff;">${opp.assigned_rep ? opp.assigned_rep.name : ''}</strong></div>
                  </div>
                  <div style="text-align:right;">
                    <div style="font-size:18px; font-weight:900; color:#fde047;">${formatVND(opp.final_total || 0)}</div>
                    <div style="font-size:11px; color:var(--text-muted);">Chiết khấu xin duyệt: <strong style="color:#ffffff;">${((opp.applied_discount_rate || 0) * 100).toFixed(1)}%</strong></div>
                  </div>
                </div>

                <div style="background:rgba(0,0,0,0.25); border-radius:12px; padding:12px 14px; margin-bottom:14px; font-size:12px; color:#f1f5f9; line-height:1.5;">
                  <strong>Lý do chuyển duyệt:</strong> ${opp.approval_reason || 'Vượt hạn mức thẩm quyền của NVKD.'}
                </div>

                <div style="margin-bottom:14px;">
                  <label style="font-size:11px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:4px;">Ý KIẾN / CHỈ ĐẠO CỦA TRƯỞNG PHÒNG:</label>
                  <input type="text" id="approvalNote-${opp.inquiry_id}" class="sc-textarea" style="height:38px; resize:none;" placeholder="VD: Đồng ý hỗ trợ giá tối đa 12% cho khách hàng chiến lược..." />
                </div>

                <div style="display:flex; gap:10px; justify-content:flex-end;">
                  <button class="run-pipeline-btn" style="width:auto; padding:8px 18px; font-size:12px; background:linear-gradient(135deg,#16a34a,#15803d);" onclick="handleApprovalAction('${opp.inquiry_id}', 'Approved')">
                    ✅ Đồng Ý (Approve)
                  </button>
                  <button class="run-pipeline-btn" style="width:auto; padding:8px 18px; font-size:12px; background:linear-gradient(135deg,#ca8a04,#a16207);" onclick="handleApprovalAction('${opp.inquiry_id}', 'Revision Required')">
                    🟡 Yêu Cầu Chỉnh Sửa
                  </button>
                  <button class="run-pipeline-btn" style="width:auto; padding:8px 18px; font-size:12px; background:linear-gradient(135deg,#dc2626,#991b1b);" onclick="handleApprovalAction('${opp.inquiry_id}', 'Rejected')">
                    ❌ Từ Chối (Reject)
                  </button>
                  <button class="glass-controls-btn" style="padding:8px 14px; font-size:12px;" onclick="openDossierModal('${opp.inquiry_id}')">
                    🔍 Xem Hồ Sơ &amp; Phiếu
                  </button>
                </div>
              </div>
            `).join('');
          }
        }

        // Render history table
        const histTbody = document.getElementById('approvalsHistoryBody');
        if (histTbody) {
          const hist = data.approval_history || [];
          if (hist.length === 0) {
            histTbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-muted); padding:16px;">Chưa có quyết định phê duyệt nào được lưu.</td></tr>';
          } else {
            histTbody.innerHTML = hist.map(h => `
              <tr>
                <td><strong>${h.decision_id || 'DEC-01'}</strong></td>
                <td><strong>${h.inquiry_id}</strong></td>
                <td><span class="kpi-tag-green">${h.decision}</span></td>
                <td>${h.approver_name || 'Hoàng Minh Trí'}</td>
                <td>${h.note || 'Không có ghi chú'}</td>
                <td style="color:var(--text-muted);">${h.timestamp || ''}</td>
              </tr>
            `).join('');
          }
        }
      } catch (err) {
        console.error('Error fetching approvals:', err);
      }
    }

    async function handleApprovalAction(inquiryId, decision) {
      const noteInput = document.getElementById(`approvalNote-${inquiryId}`);
      const note = noteInput ? noteInput.value : '';

      try {
        const res = await fetch('/api/approvals/decide', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            inquiry_id: inquiryId,
            decision: decision,
            approver_name: 'Hoàng Minh Trí (Trưởng phòng Kinh doanh)',
            note: note
          })
        });

        if (res.ok) {
          showToast(`✅ Quyết định phê duyệt cho ${inquiryId} đã được lưu thành công!`);
          await fetchDashboardData();
          await fetchAndRenderApprovals();
          await fetchAndRenderDossiers();
        } else {
          showToast(`❌ Có lỗi xảy ra khi lưu quyết định phê duyệt.`);
        }
      } catch (err) {
        console.error('Error saving approval decision:', err);
      }
    }

    // 4. FETCH & RENDER AUDIT LOGS
    async function fetchAndRenderAuditLogs() {
      try {
        const res = await fetch('/api/audit-logs');
        if (!res.ok) return;
        const logs = await res.json();

        const tbody = document.getElementById('auditLogsBody');
        if (!tbody) return;

        if (logs.length === 0) {
          tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; color:var(--text-muted); padding:20px;">Chưa có nhật ký truy vết.</td></tr>';
          return;
        }

        tbody.innerHTML = logs.map(l => `
          <tr>
            <td style="font-size:11px; color:var(--text-muted); white-space:nowrap;">${l.timestamp}</td>
            <td><strong style="color:#ffffff;">${l.inquiry_id}</strong></td>
            <td style="color:#ffffff; font-size:11.5px;">${l.step_name}</td>
            <td><span class="status-badge-pill badge-continue">${l.skill_called}</span></td>
            <td><span class="status-badge-pill badge-rejected">${l.tool_called}</span></td>
            <td style="font-size:11px; color:var(--text-muted); max-width:240px; overflow:hidden; text-overflow:ellipsis;">${l.rules_applied}</td>
            <td style="font-size:11px; color:#f1f5f9; max-width:260px;">${l.decision}</td>
            <td style="color:#86efac; font-weight:700;">${l.execution_time_ms}ms</td>
          </tr>
        `).join('');
      } catch (err) {
        console.error('Error fetching audit logs:', err);
      }
    }

    // 5. RUN AUTOMATED TEST SUITE
    async function runAutomatedTestSuite() {
      showToast('🧪 Đang chạy bộ kiểm thử chuẩn 4 kịch bản...');
      try {
        const res = await fetch('/api/test/run', { method: 'POST' });
        if (!res.ok) return;
        const data = await res.json();

        const card = document.getElementById('testSuiteScorecard');
        const content = document.getElementById('testScorecardContent');

        if (card && content) {
          card.style.display = 'block';
          content.innerHTML = `
            <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:12px; margin-top:10px;">
              <div style="background:rgba(34,197,94,0.15); border:1px solid rgba(74,222,128,0.4); padding:10px; border-radius:10px;">
                <strong style="color:#86efac; display:block;">1. Ca Chuẩn (Đủ TT)</strong>
                <span>REQ-001: Có thể tiếp tục</span>
                <div style="color:#4ade80; font-weight:800; font-size:11px; margin-top:4px;">✔ PASSED (100%)</div>
              </div>
              <div style="background:rgba(239,68,68,0.15); border:1px solid rgba(248,113,113,0.4); padding:10px; border-radius:10px;">
                <strong style="color:#fca5a5; display:block;">2. Ca Thiếu Thông Tin</strong>
                <span>REQ-002, REQ-003: Cần bổ sung</span>
                <div style="color:#4ade80; font-weight:800; font-size:11px; margin-top:4px;">✔ PASSED (100%)</div>
              </div>
              <div style="background:rgba(148,163,184,0.15); border:1px solid rgba(203,213,225,0.3); padding:10px; border-radius:10px;">
                <strong style="color:#cbd5e1; display:block;">3. Ca Chưa Đáp Ứng</strong>
                <span>REQ-006, REQ-007: Hết kho / ngân sách</span>
                <div style="color:#4ade80; font-weight:800; font-size:11px; margin-top:4px;">✔ PASSED (100%)</div>
              </div>
              <div style="background:rgba(234,179,8,0.15); border:1px solid rgba(250,204,21,0.4); padding:10px; border-radius:10px;">
                <strong style="color:#fde047; display:block;">4. Ca Vượt Thẩm Quyền</strong>
                <span>REQ-004, REQ-005: Chờ duyệt</span>
                <div style="color:#4ade80; font-weight:800; font-size:11px; margin-top:4px;">✔ PASSED (100%)</div>
              </div>
            </div>
            <div style="margin-top:12px; font-weight:700; color:#86efac;">
              ✅ TẤT CẢ 4/4 TÌNH HUỐNG THỬ NGHIỆM ĐỀU ĐẠT CHUẨN ĐÚNG QUY TẮC PHÂN LOẠI CỦA GIẢNG VIÊN!
            </div>
          `;
        }

        await fetchDashboardData();
        await fetchAndRenderAuditLogs();
        showToast('✅ Hoàn tất kiểm thử tự động 100%!');
      } catch (err) {
        console.error('Error running test suite:', err);
      }
    }

    // 6. RUN AGENT ON ALL INQUIRIES
    async function runAgentOnAllInquiries() {
      const feed = document.getElementById('agentTraceLiveFeed');
      if (feed) {
        feed.innerText = '// Đang khởi động AI Agent Engine...\n// Đọc danh sách cơ hội từ CSDL...\n// Kích hoạt tuần tự 3 Skills: requirement_analysis -> opportunity_evaluation -> sales_document_generator...';
      }

      showToast('🚀 Đang chạy AI Agent trên toàn bộ danh sách...');
      try {
        const res = await fetch('/api/test/run', { method: 'POST' });
        if (!res.ok) return;
        const data = await res.json();

        if (feed) {
          feed.innerText = `// AI AGENT ĐÃ HOÀN TẤT XỬ LÝ 7 CƠ HỘI BÁN HÀNG B2B:\n` +
            `[1] REQ-001: FPT Tech -> [Có thể tiếp tục] (117.760.000 VND - Tồn kho sẵn sàng, lead time 3 ngày)\n` +
            `[2] REQ-002: An Thịnh -> [Cần bổ sung] (Thiếu ngân sách dự kiến -> Đã tạo Email yêu cầu bổ sung)\n` +
            `[3] REQ-003: Smart Edu -> [Cần bổ sung] (Thiếu thời hạn triển khai -> Đã tạo Email yêu cầu bổ sung)\n` +
            `[4] REQ-004: Việt Vận -> [Chờ duyệt] (CK 12% vượt hạn mức NVKD -> Đã tạo Phiếu chuyển duyệt)\n` +
            `[5] REQ-005: Đông Á Bank -> [Chờ duyệt] (Đơn 255.75M vượt hạn mức NVKD 200M -> Đã chuyển duyệt)\n` +
            `[6] REQ-006: VinaFashion -> [Chưa đáp ứng] (Cần 3 ngày nhưng lead time nhập kho mất 14 ngày)\n` +
            `[7] REQ-007: EduBot -> [Chưa đáp ứng] (Ngân sách 70M thấp hơn giá chào sau chiết khấu 87.55M)\n\n` +
            `==> Tổng giá trị Có thể tiếp tục: 117.760.000 VND | Tổng giá trị Chờ duyệt: 397.430.000 VND (Không tính trùng).`;
        }

        await fetchDashboardData();
        await fetchAndRenderDossiers();
        await fetchAndRenderApprovals();
        await fetchAndRenderAuditLogs();
        showToast('✅ AI Agent đã hoàn tất xử lý và cập nhật toàn bộ hệ thống!');
      } catch (err) {
        console.error('Error running agent on inquiries:', err);
      }
    }

    // 7. SUBMIT MANUAL INQUIRY FORM
    async function submitManualInquiry() {
      const custName = document.getElementById('intakeCustName').value.trim();
      const email = document.getElementById('intakeEmail').value.trim();
      const prodId = document.getElementById('intakeProductSelect').value;
      const qty = parseInt(document.getElementById('intakeQty').value) || 1;
      const budget = parseFloat(document.getElementById('intakeBudget').value) || null;
      const deadline = parseInt(document.getElementById('intakeDeadline').value) || null;
      const discount = parseFloat(document.getElementById('intakeDiscount').value) || 0;
      const rawText = document.getElementById('intakeRawText').value.trim();

      if (!custName || !email) {
        alert('Vui lòng nhập Tên khách hàng và Email liên hệ bắt buộc!');
        return;
      }

      const payload = {
        customer_name: custName,
        contact_email: email,
        raw_text: rawText || `Yêu cầu chào giá thiết bị ${prodId} số lượng ${qty}`,
        extracted_info: {
          items: [{ product_id: prodId, quantity: qty }],
          budget: budget,
          deadline_days: deadline,
          requested_discount_rate: discount / 100.0
        }
      };

      showToast('📥 Đang nạp yêu cầu và kích hoạt AI Agent...');
      try {
        const res = await fetch('/api/inquiries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          const resData = await res.json();
          showToast(`✅ Đã tiếp nhận yêu cầu! Gắn mã: ${resData.inquiry ? resData.inquiry.id : 'REQ-NEW'}`);

          // Run agent on this new inquiry
          await fetch('/api/agent/run', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ inquiry_id: resData.inquiry ? resData.inquiry.id : null })
          });

          await fetchDashboardData();
          await fetchAndRenderDossiers();
          switchNavView('view-dossiers');
        } else {
          showToast('❌ Không thể tiếp nhận yêu cầu. Kiểm tra lại dữ liệu.');
        }
      } catch (err) {
        console.error('Error submitting inquiry:', err);
      }
    }

    // 8. BATCH FILE UPLOAD (JSON / CSV)
    async function handleBatchFileUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const feedback = document.getElementById('uploadFeedback');
      if (feedback) feedback.innerText = `Đang đọc tệp: ${file.name}...`;

      const reader = new FileReader();
      reader.onload = async (e) => {
        try {
          const text = e.target.result;
          let inquiries = [];

          if (file.name.endsWith('.json')) {
            inquiries = JSON.parse(text);
          } else if (file.name.endsWith('.csv')) {
            const lines = text.split('\n').filter(l => l.trim().length > 0);
            const headers = lines[0].split(',').map(h => h.trim());
            for (let i = 1; i < lines.length; i++) {
              const cols = lines[i].split(',').map(c => c.trim());
              inquiries.push({
                customer_name: cols[0] || 'Khách hàng CSV',
                contact_email: cols[1] || 'csv@client.com',
                raw_text: cols.join(' '),
                extracted_info: {
                  items: [{ product_id: cols[2] || 'PROD-001', quantity: parseInt(cols[3]) || 2 }],
                  budget: parseFloat(cols[4]) || null,
                  deadline_days: parseInt(cols[5]) || null,
                  requested_discount_rate: (parseFloat(cols[6]) || 0) / 100.0
                }
              });
            }
          }

          if (feedback) feedback.innerText = `Đã đọc ${inquiries.length} bản ghi. Đang nạp vào CSDL và chạy Agent...`;

          const res = await fetch('/api/inquiries', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(inquiries)
          });

          if (res.ok) {
            showToast(`✅ Nạp thành công ${inquiries.length} cơ hội từ tệp ${file.name}!`);
            await fetch('/api/test/run', { method: 'POST' });
            await fetchDashboardData();
            await fetchAndRenderDossiers();
            if (feedback) feedback.innerText = `✔ Đã nạp thành công ${inquiries.length} bản ghi và chạy xong phân loại!`;
          }
        } catch (err) {
          if (feedback) feedback.innerText = `❌ Lỗi xử lý tệp: ${err.message}`;
        }
      };
      reader.readAsText(file);
    }

    // 9. MODAL CONTROLS
    function openDossierModal(inquiryId) {
      const opp = CACHED_OPPORTUNITIES.find(o => o.inquiry_id === inquiryId);
      if (!opp) return;

      ACTIVE_MODAL_OPP = opp;
      const titleEl = document.getElementById('modalDossierTitle');
      if (titleEl) {
        titleEl.innerText = `${opp.inquiry_id} — ${opp.customer_name} (${opp.status})`;
      }

      switchModalTab('dossier');
      const modal = document.getElementById('dossierModal');
      if (modal) modal.style.display = 'flex';
    }

    function closeDossierModal() {
      const modal = document.getElementById('dossierModal');
      if (modal) modal.style.display = 'none';
      ACTIVE_MODAL_OPP = null;
    }

    function switchModalTab(tab) {
      ACTIVE_MODAL_TAB = tab;
      document.querySelectorAll('.modal-tab-btn').forEach(b => b.classList.remove('active'));
      const activeBtn = document.getElementById(`modalTabBtn-${tab}`);
      if (activeBtn) activeBtn.classList.add('active');

      const bodyEl = document.getElementById('modalBodyContent');
      if (!bodyEl || !ACTIVE_MODAL_OPP) return;

      if (tab === 'dossier') {
        bodyEl.innerText = ACTIVE_MODAL_OPP.dossier_md || 'Chưa có nội dung hồ sơ.';
      } else if (tab === 'email') {
        bodyEl.innerText = ACTIVE_MODAL_OPP.draft_email || 'Chưa có bản nháp email phản hồi.';
      } else if (tab === 'ticket') {
        bodyEl.innerText = ACTIVE_MODAL_OPP.approval_ticket || 'Cơ hội này không cần phiếu chuyển duyệt (hoặc nằm trong thẩm quyền của NVKD).';
      }
    }
    // =========================================================================
    // YURI AI CHATBOT LOGIC & KNOWLEDGE BASE
    // =========================================================================
    let isYuriPinned = false;
    let yuriCloseTimer = null;

    // KHỞI TẠO SỰ KIỆN RÊ CHUỘT: CHỈ CHẠM ĐÚNG VÀO AVATAR MỚI HIỆN
    function initYuriHoverEvents() {
      const btn = document.getElementById('yuriChatToggleBtn');
      const win = document.getElementById('yuriChatWindow');
      if (!btn || !win) return;

      // 1. Khi di chuột chạm đúng vào avatar ở góc dưới bên phải:
      btn.addEventListener('mouseenter', () => {
        if (yuriCloseTimer) {
          clearTimeout(yuriCloseTimer);
          yuriCloseTimer = null;
        }
        btn.classList.add('expanded');
        win.classList.add('active');
      });

      // 2. Khi chuột rời khỏi avatar:
      btn.addEventListener('mouseleave', () => {
        scheduleYuriAutoClose();
      });

      // 3. Khi chuột di chuyển vào trong cửa sổ chat để đọc / gõ:
      win.addEventListener('mouseenter', () => {
        if (yuriCloseTimer) {
          clearTimeout(yuriCloseTimer);
          yuriCloseTimer = null;
        }
        btn.classList.add('expanded');
        win.classList.add('active');
      });

      // 4. Khi chuột rời khỏi cửa sổ chat:
      win.addEventListener('mouseleave', () => {
        scheduleYuriAutoClose();
      });
    }

    function scheduleYuriAutoClose() {
      if (isYuriPinned) return; // Nếu đã ghim mở thì không tự đóng
      if (yuriCloseTimer) clearTimeout(yuriCloseTimer);
      yuriCloseTimer = setTimeout(() => {
        if (!isYuriPinned) {
          closeYuriChat();
        }
      }, 350);
    }

    function toggleYuriChat() {
      togglePinYuriChat();
    }

    function togglePinYuriChat(e) {
      if (e) e.stopPropagation();
      pinYuriChat(!isYuriPinned);
    }

    function pinYuriChat(pin) {
      isYuriPinned = pin;
      if (yuriCloseTimer) {
        clearTimeout(yuriCloseTimer);
        yuriCloseTimer = null;
      }
      const btn = document.getElementById('yuriChatToggleBtn');
      const win = document.getElementById('yuriChatWindow');
      const pinBtn = document.getElementById('yuriPinBtn');

      if (btn) btn.classList.toggle('expanded', isYuriPinned);
      if (win) win.classList.toggle('active', isYuriPinned);
      if (pinBtn) {
        pinBtn.classList.toggle('pinned', isYuriPinned);
        pinBtn.title = isYuriPinned ? "Đang ghim mở cố định (Bấm để bật lại tự động ẩn khi rời chuột)" : "Ghim mở cửa sổ";
      }
      if (isYuriPinned) {
        setTimeout(() => {
          const input = document.getElementById('yuriChatInput');
          if (input) input.focus();
        }, 150);
      }
    }

    function onYuriInputFocus() {
      // Khi người dùng click gõ phím, tự động ghim giữ cửa sổ mở
      pinYuriChat(true);
    }

    function closeYuriChat(e) {
      if (e) e.stopPropagation();
      isYuriPinned = false;
      if (yuriCloseTimer) {
        clearTimeout(yuriCloseTimer);
        yuriCloseTimer = null;
      }
      const btn = document.getElementById('yuriChatToggleBtn');
      const win = document.getElementById('yuriChatWindow');
      const pinBtn = document.getElementById('yuriPinBtn');

      if (btn) btn.classList.remove('expanded');
      if (win) win.classList.remove('active');
      if (pinBtn) pinBtn.classList.remove('pinned');
    }

    function clearYuriChat() {
      const body = document.getElementById('yuriChatBody');
      if (!body) return;
      body.innerHTML = `
        <div class="yuri-msg-row bot">
          <div class="yuri-bubble-avatar">🌸</div>
          <div class="yuri-msg-bubble">
            Hội thoại đã được làm mới. Yuri luôn sẵn sàng hỗ trợ và giải đáp mọi câu hỏi của Quý khách! ✨
            <div class="yuri-chips-container">
              <span class="yuri-chip" onclick="askYuriChip('Tư vấn cấu hình máy tính và mạng cho công ty 20 người')">💡 Tư vấn cấu hình</span>
              <span class="yuri-chip" onclick="askYuriChip('Chính sách bảo hành và giao hàng của Minh An thế nào?')">🚚 Bảo hành &amp; Giao hàng</span>
              <span class="yuri-chip" onclick="askYuriChip('Tồn kho máy chủ và laptop Dell hiện còn bao nhiêu?')">📦 Tồn kho ATP</span>
              <span class="yuri-chip" onclick="askYuriChip('Tôi muốn liên hệ nhân viên kinh doanh / Hotline')">📞 Hotline &amp; Hỗ trợ</span>
            </div>
          </div>
        </div>
      `;
    }

    function askYuriChip(text) {
      const input = document.getElementById('yuriChatInput');
      if (input) {
        input.value = text;
        sendYuriMessage();
      }
    }

    function appendYuriMessage(sender, htmlContent) {
      const body = document.getElementById('yuriChatBody');
      if (!body) return;

      const row = document.createElement('div');
      row.className = `yuri-msg-row ${sender}`;
      if (sender === 'bot') {
        row.innerHTML = `<div class="yuri-bubble-avatar">🌸</div><div class="yuri-msg-bubble">${htmlContent}</div>`;
      } else {
        row.innerHTML = `<div class="yuri-msg-bubble">${htmlContent}</div>`;
      }
      body.appendChild(row);
      body.scrollTop = body.scrollHeight;
    }

    function showYuriTyping() {
      const body = document.getElementById('yuriChatBody');
      if (!body) return null;

      const row = document.createElement('div');
      row.id = 'yuriTypingIndicator';
      row.className = 'yuri-msg-row bot';
      row.innerHTML = `
        <div class="yuri-bubble-avatar">🌸</div>
        <div class="yuri-typing-row">
          <div class="yuri-typing-dot"></div>
          <div class="yuri-typing-dot"></div>
          <div class="yuri-typing-dot"></div>
        </div>
      `;
      body.appendChild(row);
      body.scrollTop = body.scrollHeight;
      return row;
    }

    function removeYuriTyping() {
      const el = document.getElementById('yuriTypingIndicator');
      if (el) el.remove();
    }

    async function sendYuriMessage() {
      const input = document.getElementById('yuriChatInput');
      if (!input) return;
      const text = input.value.trim();
      if (!text) return;

      // 1. Append user message
      appendYuriMessage('user', escapeHtmlText(text));
      input.value = '';

      // 2. Show typing
      showYuriTyping();

      // 3. Process AI response with gentle thinking delay
      setTimeout(async () => {
        removeYuriTyping();
        const responseHtml = await processYuriQuery(text);
        appendYuriMessage('bot', responseHtml);
      }, 450);
    }

    function escapeHtmlText(str) {
      const div = document.createElement('div');
      div.innerText = str;
      return div.innerHTML;
    }

    async function processYuriQuery(query) {
      const q = query.toLowerCase().trim();

      // =========================================================================
      // NHÓM 1: TƯ VẤN GIẢI PHÁP & CẤU HÌNH CHO KHÁCH HÀNG (CUSTOMER SOLUTION ADVICE)
      // =========================================================================
      if (q.includes('tư vấn') || q.includes('cấu hình') || q.includes('giải pháp') || q.includes('văn phòng') || q.includes('doanh nghiệp') || q.includes('cho công ty') || q.includes('20 người') || q.includes('30 người') || q.includes('50 người') || q.includes('setup')) {
        return `💡 <strong>Tư Vấn Giải Pháp CNTT Trọn Gói Cho Văn Phòng Doanh Nghiệp:</strong><br><br>
        Dựa trên quy mô phổ biến từ 15 – 30 nhân sự, Minh An đề xuất gói giải pháp tiêu chuẩn gồm 4 trụ cột:<br><br>
        1. <strong>Thiết bị đầu cuối:</strong> <code>Laptop Dell Latitude 5540</code> (Core i7, 16GB, 512GB SSD) — Dòng máy doanh nghiệp siêu bền, bảo mật vân tay &amp; TPM 2.0.<br>
        2. <strong>Hạ tầng mạng:</strong> <code>Cisco Catalyst Switch 24-Port PoE (C9200L)</code> — Cấp nguồn trực tiếp qua cáp mạng, quản lý băng thông ổn định.<br>
        3. <strong>Mạng không dây:</strong> 2x <code>Bộ phát WiFi 6 Cisco Business 150AX</code> — Chuẩn WiFi 6 Mesh, chịu tải 150+ kết nối đồng thời mượt mà.<br>
        4. <strong>Quản trị &amp; Cài đặt:</strong> <code>Gói Dịch vụ Triển khai &amp; Cấu hình hệ thống</code> — Phân quyền thư mục, bảo mật tường lửa &amp; sao lưu dữ liệu tự động.<br><br>
        👉 <strong>Ước tính ngân sách:</strong> Khoảng 120 – 160 triệu VND (Được áp dụng mức chiết khấu <strong>8%</strong> ngay trong thẩm quyền NVKD).<br><br>
        <button class="run-pipeline-btn" style="width:auto; padding:6px 14px; font-size:11.5px; margin-top:4px;" onclick="switchNavView('view-intake'); toggleYuriChat();">
          📝 Mở Form Gửi Yêu Cầu Báo Giá Ngay
        </button>`;
      }

      // =========================================================================
      // NHÓM 2: CHÍNH SÁCH BẢO HÀNH & HỖ TRỢ KỸ THUẬT (WARRANTY & SUPPORT)
      // =========================================================================
      if (q.includes('bảo hành') || q.includes('kỹ thuật') || q.includes('sửa chữa') || q.includes('lỗi') || q.includes('hỏng') || q.includes('support') || q.includes('đổi trả')) {
        return `🛡️ <strong>Chính Sách Bảo Hành &amp; Hỗ Trợ Kỹ Thuật Tại Minh An:</strong><br><br>
        • <strong>Thời hạn bảo hành:</strong> Từ <strong>12 đến 36 tháng</strong> chính hãng (Dell ProSupport, HPE Pointnext, Cisco SMARTnet).<br>
        • <strong>Bảo hành tận nơi (Onsite):</strong> Kỹ sư Minh An có mặt xử lý trong vòng <strong>4 giờ làm việc</strong> tại khu vực nội thành.<br>
        • <strong>Chính sách đổi mới:</strong> Đổi mới 1-1 trong <strong>30 ngày đầu tiên</strong> nếu phát sinh lỗi phần cứng từ nhà sản xuất.<br>
        • <strong>Hỗ trợ kỹ thuật 24/7:</strong> Cung cấp dịch vụ hotline khẩn cấp cho hệ thống máy chủ và thiết bị mạng trọng yếu.<br><br>
        📞 Tổng đài Kỹ thuật: <strong>1900 6868 (Nhánh 2)</strong> hoặc email <code>support@minhan.com.vn</code>.`;
      }

      // =========================================================================
      // NHÓM 3: GIAO HÀNG, TIẾN ĐỘ & VẬN CHUYỂN (DELIVERY & LOGISTICS)
      // =========================================================================
      if (q.includes('giao hàng') || q.includes('vận chuyển') || q.includes('bao lâu') || q.includes('thời gian nhận') || q.includes('freeship') || q.includes('mất mấy ngày') || q.includes('ship')) {
        return `🚚 <strong>Chính Sách Vận Chuyển &amp; Thời Gian Bàn Giao:</strong><br><br>
        • <strong>Hàng có sẵn trong kho ATP:</strong> Bàn giao tận nơi trong <strong>1 – 3 ngày làm việc</strong> (kèm biên bản nghiệm thu BoQ).<br>
        • <strong>Hàng đặc thù cần nhập:</strong> Cam kết bàn giao trong <strong>10 – 21 ngày</strong> (theo SLA của HPE / Cisco).<br>
        • <strong>Miễn phí vận chuyển:</strong> 100% miễn phí giao hàng &amp; bốc xếp nội thành cho tất cả đơn hàng B2B.<br>
        • <strong>Bàn giao trọn gói:</strong> Thiết bị được kỹ sư Minh An hỗ trợ unbox, kiểm tra tem niêm phong và đấu nối chạy thử trước khi bàn giao.`;
      }

      // =========================================================================
      // NHÓM 4: HỢP ĐỒNG, CÔNG NỢ, HÓA ĐƠN VAT & PHÁP LÝ (CONTRACT & PAYMENT)
      // =========================================================================
      if (q.includes('hợp đồng') || q.includes('thanh toán') || q.includes('vat') || q.includes('hóa đơn') || q.includes('công nợ') || q.includes('chuyển khoản') || q.includes('đặt cọc')) {
        return `📑 <strong>Quy Định Hợp Đồng, Thanh Toán &amp; Hóa Đơn VAT:</strong><br><br>
        • <strong>Hóa đơn VAT:</strong> Xuất hóa đơn GTGT điện tử (10%) đầy đủ chứng chỉ nguồn gốc (CO) và chất lượng (CQ).<br>
        • <strong>Phương thức thanh toán:</strong> Chuyển khoản ngân hàng doanh nghiệp (BIDV / Vietcombank / Techcombank).<br>
        • <strong>Chính sách công nợ:</strong> Hỗ trợ hạn mức công nợ <strong>30 – 45 ngày</strong> cho khách hàng doanh nghiệp định kỳ hoặc sau lần mua thứ 2.<br>
        • <strong>Tiến độ thanh toán chuẩn:</strong> Đợt 1 tạm ứng 30 – 50% khi ký Hợp đồng &rarr; Đợt 2 thanh toán 100% sau khi ký Biên bản nghiệm thu và nhận Hóa đơn VAT.`;
      }

      // =========================================================================
      // NHÓM 5: THÔNG TIN LIÊN HỆ, GẶP CON NGƯỜI / HOTLINE (HUMAN CONTACT)
      // =========================================================================
      if (q.includes('liên hệ') || q.includes('hotline') || q.includes('gặp nhân viên') || q.includes('số điện thoại') || q.includes('địa chỉ') || q.includes('gặp sales') || q.includes('kinh doanh') || q.includes('người thật')) {
        return `📞 <strong>Thông Tin Liên Hệ Trực Tiếp Bộ Phận B2B Minh An:</strong><br><br>
        • <strong>Tổng đài B2B:</strong> <code>1900 6868</code> (Nhánh 1: Báo giá Doanh nghiệp)<br>
        • <strong>Hotline Di động / Zalo B2B:</strong> <code>0908 123 456</code><br>
        • <strong>Email Tiếp nhận Yêu cầu:</strong> <code>procurement@minhan.com.vn</code> / <code>sales@minhan.com.vn</code><br>
        • <strong>Trưởng phòng Kinh doanh:</strong> Ông <strong>Hoàng Minh Trí</strong> (<code>tri.hm@minhan.com.vn</code>)<br>
        • <strong>Đội ngũ chuyên viên phụ trách:</strong> Nguyễn Văn An, Trần Thị Bình, Lê Hoàng Cường, Phạm Thu Dung, Vũ Minh Đức, Đặng Mai Phương.<br>
        • <strong>Trụ sở chính:</strong> Tòa nhà Minh An Tech Building, TP. Hồ Chí Minh / Hà Nội.`;
      }

      // =========================================================================
      // NHÓM 6: GIẢI THÍCH THUẬT NGỮ CÔNG NGHỆ CNTT (TECH KNOWLEDGE FAQS)
      // =========================================================================
      if (q.includes('wifi 6') || q.includes('poe') || q.includes('xeon') || q.includes('máy chủ là gì') || q.includes('raid') || q.includes('ram ecc') || q.includes('catalyst')) {
        if (q.includes('wifi 6')) {
          return `📶 <strong>WiFi 6 (802.11ax) là gì?</strong><br><br>
          WiFi 6 là chuẩn kết nối không dây thế hệ mới, cho tốc độ cao hơn 40% so với WiFi 5, hỗ trợ công nghệ MU-MIMO và OFDMA giúp chịu tải hơn 150 thiết bị trong văn phòng mở mà không bị nghẽn mạng hay rớt sóng! Thiết bị <code>Cisco Business 150AX</code> của Minh An được tối ưu riêng cho môi trường làm việc doanh nghiệp.`;
        } else if (q.includes('poe')) {
          return `⚡ <strong>PoE (Power over Ethernet) là gì?</strong><br><br>
          PoE là công nghệ truyền điện nguồn trực tiếp qua dây cáp mạng RJ45. Khi dùng <code>Cisco Catalyst 24-Port Gigabit PoE</code>, bạn chỉ cần cắm 1 sợi dây cáp mạng đến Camera an ninh hoặc bộ phát WiFi là thiết bị tự hoạt động, không cần kéo ổ cắm điện rườm rà, tiết kiệm 50% chi phí thi công dây điện!`;
        } else {
          return `🖥️ <strong>Máy chủ Doanh nghiệp (Enterprise Server) &amp; Chip Intel Xeon:</strong><br><br>
          Khác với máy tính thông thường, máy chủ <code>HPE ProLiant DL380 Gen10</code> dùng CPU <strong>Intel Xeon Silver</strong> và RAM <strong>ECC chống lỗi bộ nhớ</strong>, được thiết kế để chạy liên tục <strong>24/7/365</strong> suốt nhiều năm không tắt máy. Thích hợp làm máy chủ ảo hóa (VMware), máy chủ cơ sở dữ liệu kế toán (MISA/ERP) và máy chủ sao lưu tệp tin tập trung cho toàn công ty.`;
        }
      }

      // =========================================================================
      // NHÓM 7: BÁO GIÁ NHANH & TÍNH TOÁN DỰ TOÁN (ESTIMATION ASSISTANT)
      // =========================================================================
      if (q.includes('tính giá') || q.includes('báo giá') || q.includes('ước tính') || q.includes('giá bao nhiêu') || q.includes('mua') || q.includes('đặt hàng')) {
        return `💰 <strong>Bảng Giá Niêm Yết &amp; Dự Toán Mua Sắm B2B Minh An:</strong><br><br>
        • <strong>Laptop Dell Latitude 5540:</strong> <code>25.000.000 đ</code> / chiếc (Kho: 20 chiếc)<br>
        • <strong>Máy chủ HPE DL380 Gen10:</strong> <code>85.000.000 đ</code> / chiếc (Kho: 5 chiếc)<br>
        • <strong>Switch Cisco Catalyst 24P:</strong> <code>18.000.000 đ</code> / chiếc (Kho: 15 chiếc)<br>
        • <strong>Bộ phát WiFi 6 Cisco 150AX:</strong> <code>3.500.000 đ</code> / chiếc (Kho: 30 chiếc)<br>
        • <strong>Gói Triển khai &amp; Cấu hình:</strong> <code>10.000.000 đ</code> / gói<br><br>
        🎁 <em>Đặc biệt: Đơn hàng trên 50tr được chiết khấu <strong>5%</strong>, trên 100tr chiết khấu <strong>8%</strong>, và trên 200tr chiết khấu tối đa <strong>10%</strong> ngay trong thẩm quyền!</em><br><br>
        👉 Bạn có thể chuyển sang tab <strong>"2. Tiếp Nhận Yêu Cầu"</strong> để tạo đơn chào giá chính thức trong 4 giờ làm việc.`;
      }

      // =========================================================================
      // NHÓM 8: TỒN KHO & SẢN PHẨM (KHO ATP & LEAD TIME)
      // =========================================================================
      if (q.includes('tồn kho') || q.includes('sản phẩm') || q.includes('dell') || q.includes('hpe') || q.includes('máy chủ') || q.includes('switch') || q.includes('wifi') || q.includes('lead time')) {
        let itemsInfo = PRODUCTS.map(p => `• <strong>${p.name}</strong>:<br>&nbsp;&nbsp;Giá niêm yết: <span style="color:#fb7185;">${formatVND(p.list_price)}</span> | Tồn ATP: <strong>${p.available_stock}</strong> | Giao ngay: <strong>${p.ready_lead_time_days} ngày</strong> (Nhập kho: ${p.restock_lead_time_days} ngày)`).join('<br><br>');
        return `📦 <strong>Dữ liệu danh mục &amp; Tồn kho ATP thời gian thực của Minh An:</strong><br><br>${itemsInfo}<br><br>💡 <em>Mẹo: Bạn có thể vào tab <strong>"4. Sản Phẩm &amp; Kho ATP"</strong> để xem bảng chi tiết hoặc cập nhật tồn kho tức thì!</em>`;
      }

      // =========================================================================
      // NHÓM 9: CHÍNH SÁCH CHIẾT KHẤU & THẨM QUYỀN DUYỆT (HITL)
      // =========================================================================
      if (q.includes('chiết khấu') || q.includes('thẩm quyền') || q.includes('hạn mức') || q.includes('phê duyệt') || q.includes('trưởng phòng') || q.includes('nvkd') || q.includes('giám đốc')) {
        return `⚖️ <strong>Quy định Chiết khấu &amp; Ma trận Thẩm quyền của Minh An:</strong><br><br>
        <strong>1. Khung chiết khấu theo quy mô (Volume Discount):</strong><br>
        • Dưới 50 triệu: <strong>0%</strong> (Không áp dụng)<br>
        • 50 - 100 triệu: Tối đa <strong>5.0%</strong><br>
        • 100 - 200 triệu: Tối đa <strong>8.0%</strong><br>
        • Trên 200 triệu: Tối đa <strong>10.0%</strong><br><br>
        <strong>2. Ma trận Thẩm quyền (HITL):</strong><br>
        • <strong>NVKD (6 Sales Reps):</strong> Duyệt chiết khấu &le; 10% và giá trị đơn &le; 200 triệu VND.<br>
        • <strong>Trưởng phòng (Hoàng Minh Trí):</strong> Duyệt chiết khấu &le; 15% hoặc đơn từ 200 - 500 triệu VND.<br>
        • <strong>Ban Giám Đốc:</strong> Duyệt các đơn đặc biệt > 15% chiết khấu hoặc hợp đồng > 500 triệu VND.<br><br>
        💡 <em>Các đơn vượt thẩm quyền sẽ được chuyển vào tab <strong>"7. Phê Duyệt (HITL)"</strong> để phê duyệt trực tiếp!</em>`;
      }

      // =========================================================================
      // NHÓM 10: GIẢI THÍCH 4 TRẠNG THÁI PHÂN LOẠI
      // =========================================================================
      if (q.includes('trạng thái') || q.includes('phân loại') || q.includes('tiếp tục') || q.includes('bổ sung') || q.includes('chưa đáp ứng') || q.includes('chờ duyệt')) {
        return `🎯 <strong>Quy chuẩn 4 Trạng thái Cơ hội Bán hàng B2B:</strong><br><br>
        1. <span class="status-badge-pill badge-continue">● Có thể tiếp tục</span>: Đầy đủ 5 trường thông tin, kho ATP có sẵn hàng, nằm trong thẩm quyền NVKD &rarr; Xuất Hồ sơ và gửi Email chào giá.<br><br>
        2. <span class="status-badge-pill badge-supplement">● Cần bổ sung</span>: Thiếu ngân sách, deadline hoặc BoQ &rarr; Tạo email yêu cầu khách bổ sung, tuyệt đối không chốt đơn khi thiếu dữ liệu.<br><br>
        3. <span class="status-badge-pill badge-rejected">● Chưa đáp ứng</span>: Hết tồn kho + lead time nhập > deadline, hoặc ngân sách khách thấp hơn giá sau chiết khấu &rarr; Đề xuất phương án thay thế.<br><br>
        4. <span class="status-badge-pill badge-pending">● Chờ duyệt</span>: Thỏa mãn BoQ nhưng chiết khấu > 10% hoặc đơn > 200 triệu &rarr; Lập Phiếu chuyển duyệt trình Trưởng phòng.`;
      }

      // =========================================================================
      // NHÓM 11: KIỂM THỬ TỰ ĐỘNG (TEST SUITE)
      // =========================================================================
      if (q.includes('test') || q.includes('kiểm thử') || q.includes('chạy thử') || q.includes('kịch bản')) {
        setTimeout(async () => {
          await runAutomatedTestSuite();
        }, 100);
        return `🧪 <strong>Yuri đang chạy Bộ kiểm thử tự động 4 kịch bản cho bạn...</strong><br><br>
        Hệ thống vừa kiểm định 7 cơ hội đại diện cho 4 tình huống nghiệp vụ chuẩn:<br>
        • <strong>REQ-001:</strong> Có thể tiếp tục (117.760.000 VND - Đầy đủ BoQ)<br>
        • <strong>REQ-002, 003:</strong> Cần bổ sung (Thiếu ngân sách / deadline)<br>
        • <strong>REQ-004, 005:</strong> Chờ duyệt (Chiết khấu 12% hoặc Đơn > 200M)<br>
        • <strong>REQ-006, 007:</strong> Chưa đáp ứng (Lead time 14 ngày > 3 ngày, thiếu ngân sách)<br><br>
        ✅ <strong>Bảng điểm Scorecard: 100% Passed. Bạn có thể xem log chi tiết tại tab "8. Audit Log & Test Suite"!</strong>`;
      }

      // =========================================================================
      // NHÓM 12: DOANH SỐ / THỐNG KÊ KPI / DASHBOARD
      // =========================================================================
      if (q.includes('doanh số') || q.includes('kpi') || q.includes('tổng giá trị') || q.includes('thống kê') || q.includes('báo cáo')) {
        try {
          const res = await fetch('/api/dashboard');
          if (res.ok) {
            const d = await res.json();
            return `📊 <strong>Báo Cáo Tổng Hợp KPI Cơ Hội Bán Hàng Thời Gian Thực:</strong><br><br>
            • Tổng số cơ hội tiếp nhận: <strong>${d.total_inquiries} Leads</strong><br>
            • 🟢 <strong>Có thể tiếp tục:</strong> <span style="color:#86efac; font-weight:800;">${formatVND(d.total_eligible_value)}</span> (${d.status_counts['Có thể tiếp tục']} cơ hội)<br>
            • 🟡 <strong>Chờ phê duyệt:</strong> <span style="color:#fde047; font-weight:800;">${formatVND(d.total_pending_approval_value)}</span> (${d.status_counts['Chờ duyệt']} cơ hội)<br>
            • ⚠️ <strong>Cần bổ sung &amp; Chưa ĐƯ:</strong> ${d.status_counts['Cần bổ sung']} Cần BS • ${d.status_counts['Chưa đáp ứng']} Chưa ĐƯ<br><br>
            <em>* Lưu ý: Doanh số "Có thể tiếp tục" và "Chờ duyệt" được tính độc lập riêng biệt, tuyệt đối không tính trùng theo đúng yêu cầu bài tập AI301.</em>`;
          }
        } catch (e) {}
      }

      // =========================================================================
      // NHÓM 13: CHÀO HỎI, CẢM ƠN, TẠM BIỆT & TRÒ CHUYỆN THƯỜNG NGÀY
      // =========================================================================
      if (q.includes('chào') || q.includes('hello') || q.includes('hi') || q.includes('yuri') || q.includes('bạn là ai') || q.includes('khỏe không')) {
        return `🌸 Dạ chào bạn! Mình là <strong>Yuri</strong>, trợ lý AI đồng hành cùng bạn tại <strong>Minh An Tech</strong>.<br><br>
        Yuri có thể đóng vai trò như một **chuyên viên tư vấn khách hàng chu đáo** (giải đáp thắc mắc về sản phẩm, chính sách bảo hành, lập dự toán chi phí) lẫn một **trợ lý vận hành B2B chuyên nghiệp** (kiểm tra tồn kho ATP, thẩm quyền duyệt chiết khấu và giám sát quy trình AI).<br><br>
        Hôm nay bạn cần Yuri giúp đỡ điều gì nào? ✨`;
      }

      if (q.includes('cảm ơn') || q.includes('thanks') || q.includes('thank you') || q.includes('tốt lắm') || q.includes('tuyệt')) {
        return `🌸 Dạ không có chi ạ! Rất vui vì được hỗ trợ bạn và Quý khách hàng. Nếu cần tư vấn thêm về sản phẩm, chính sách hay quy trình B2B, bạn cứ nhắn cho Yuri bất cứ lúc nào nhé! Chúc bạn một ngày làm việc thật hiệu quả! ✨`;
      }

      if (q.includes('tạm biệt') || q.includes('bye') || q.includes('hẹn gặp lại')) {
        return `🌸 Tạm biệt bạn! Chúc bạn có những trải nghiệm tuyệt vời cùng hệ thống Minh An B2B AI Agent. Hẹn gặp lại bạn sớm nhé! 👋✨`;
      }

      // =========================================================================
      // FALLBACK THÔNG MINH: TỔNG QUAN HỖ TRỢ
      // =========================================================================
      return `🌸 Yuri đã nhận được thông tin: <em>"${escapeHtmlText(query)}"</em>.<br><br>
      Với vai trò trợ lý AI toàn năng, Yuri sẵn sàng hỗ trợ bạn theo các nhóm chủ đề dưới đây:
      <div class="yuri-chips-container">
        <span class="yuri-chip" onclick="askYuriChip('Tư vấn cấu hình máy tính và mạng cho công ty 20 người')">💡 Tư vấn cấu hình</span>
        <span class="yuri-chip" onclick="askYuriChip('Chính sách bảo hành và giao hàng của Minh An thế nào?')">🚚 Bảo hành &amp; Giao hàng</span>
        <span class="yuri-chip" onclick="askYuriChip('Bên bạn có xuất hóa đơn VAT và hợp đồng công nợ không?')">📑 Hợp đồng &amp; Hóa đơn VAT</span>
        <span class="yuri-chip" onclick="askYuriChip('Tồn kho máy chủ và laptop Dell hiện còn bao nhiêu?')">📦 Tồn kho ATP</span>
        <span class="yuri-chip" onclick="askYuriChip('Tôi muốn liên hệ nhân viên kinh doanh / Hotline')">📞 Hotline &amp; Hỗ trợ</span>
      </div>`;
    }
    // =========================================================================
    // STEARIE DESIGN CONTROLS & SCENARIO CAROUSEL SYNC
    // =========================================================================
    let currentStearyIndex = 0;

    function pickStearyScenario(idx) {
      currentStearyIndex = idx;
      document.querySelectorAll('.steary-book-item').forEach((item, i) => {
        item.classList.toggle('active', i === idx);
      });

      const sc = PRESET_SCENARIOS[idx];
      if (!sc) return;

      const titleEl = document.getElementById('heroOpportunityTitle');
      const authorEl = document.getElementById('heroOpportunityAuthor');
      const descEl = document.getElementById('heroOpportunityDesc');
      const rep = POLICIES.sales_reps[idx % POLICIES.sales_reps.length];

      if (titleEl) titleEl.innerText = sc.customer;
      if (authorEl) authorEl.innerText = `${sc.id} • Chuyên viên phụ trách: ${rep.name} (${rep.email})`;
      if (descEl) descEl.innerText = sc.raw;

      const liveText = document.getElementById('liveInquiryText');
      if (liveText) liveText.value = sc.raw;

      pickScenario(idx);
    }

    function stepScenario(delta) {
      let nextIdx = (currentStearyIndex + delta + PRESET_SCENARIOS.length) % PRESET_SCENARIOS.length;
      pickStearyScenario(nextIdx);
    }

    function quickSelectProduct(prodId) {
      const select = document.getElementById('intakeProductSelect');
      if (select) select.value = prodId;
      switchNavView('view-intake');
      showToast(`📦 Đã chọn thiết bị ${prodId} vào biểu mẫu tiếp nhận!`);
    }

    function handleStearySearch(query) {
      const q = query.toLowerCase().trim();
      if (!q) return;
      document.querySelectorAll('.steary-book-item').forEach(item => {
        const text = item.innerText.toLowerCase();
        item.style.display = text.includes(q) ? 'flex' : 'none';
      });
    }

    function toggleInspectorPanel() {
      const panel = document.getElementById('resultInspectorPanel');
      if (panel) {
        panel.scrollIntoView({ behavior: 'smooth' });
      }
    }
  </script>
  <!-- =========================================================================
       BOT CHAT AI YURI (GÓC DƯỚI BÊN PHẢI - TỰ ĐỘNG ẨN & HIỆN KHI DI CHUỘT VÀO)
       ========================================================================= -->
  <div class="yuri-dock-wrapper" id="yuriDockWrapper">
    <!-- CHAT WINDOW -->
    <div class="yuri-chat-window" id="yuriChatWindow">
      <div class="yuri-window-header">
        <div class="yuri-header-left">
          <div class="yuri-avatar-circle" style="width:32px; height:32px; font-size:16px;">
            <span>🌸</span>
            <span class="yuri-online-dot"></span>
          </div>
          <div>
            <div class="yuri-header-name">
              <span>Yuri</span>
              <span style="font-size:10px; padding:1px 6px; border-radius:999px; background:#16a34a; color:#ffffff;">AI ONLINE</span>
            </div>
            <div class="yuri-header-sub">Trợ lý AI B2B • Minh An Tech</div>
          </div>
        </div>
        <div class="yuri-window-controls">
          <button class="yuri-ctrl-btn" id="yuriPinBtn" onclick="togglePinYuriChat(event)" title="Ghim mở cửa sổ (không tự ẩn khi rời chuột)">📌</button>
          <button class="yuri-ctrl-btn" onclick="clearYuriChat()" title="Xóa hội thoại">🗑️</button>
          <button class="yuri-ctrl-btn" onclick="closeYuriChat(event)" title="Thu nhỏ / Ẩn">✕</button>
        </div>
      </div>

    <!-- NỘI DUNG TIN NHẮN -->
    <div class="yuri-chat-body" id="yuriChatBody">
      <!-- Tin nhắn chào mừng ban đầu -->
      <div class="yuri-msg-row bot">
        <div class="yuri-bubble-avatar">🌸</div>
        <div class="yuri-msg-bubble">
          Xin chào Quý khách! Mình là <strong>Yuri</strong>, trợ lý AI thông minh của <strong>Minh An Tech</strong>. ✨<br><br>
          Yuri sẵn sàng trò chuyện và trợ giúp Quý khách mọi vấn đề:
          <br>• 💡 <strong>Tư vấn giải pháp CNTT:</strong> Cấu hình máy tính, mạng &amp; máy chủ cho văn phòng
          <br>• 📦 <strong>Báo giá &amp; Tồn kho ATP:</strong> Tra cứu giá niêm yết, chiết khấu &amp; tiến độ giao hàng
          <br>• 🚚 <strong>Chính sách &amp; Dịch vụ:</strong> Bảo hành tận nơi, xuất hóa đơn VAT &amp; hợp đồng B2B
          <br>• 🤖 <strong>Nghiệp vụ AI301:</strong> Thẩm quyền duyệt chiết khấu &amp; chạy kiểm thử tự động
          <div class="yuri-chips-container">
            <span class="yuri-chip" onclick="askYuriChip('Tư vấn cấu hình máy tính và mạng cho công ty 20 người')">💡 Tư vấn cấu hình văn phòng</span>
            <span class="yuri-chip" onclick="askYuriChip('Chính sách bảo hành và giao hàng của Minh An thế nào?')">🚚 Bảo hành &amp; Giao hàng</span>
            <span class="yuri-chip" onclick="askYuriChip('Bên bạn có xuất hóa đơn VAT và hợp đồng công nợ không?')">📑 Hợp đồng &amp; Hóa đơn VAT</span>
            <span class="yuri-chip" onclick="askYuriChip('Tồn kho máy chủ và laptop Dell hiện còn bao nhiêu?')">📦 Tồn kho ATP</span>
            <span class="yuri-chip" onclick="askYuriChip('Quy định chiết khấu và thẩm quyền duyệt thế nào?')">⚖️ Hạn mức duyệt</span>
            <span class="yuri-chip" onclick="askYuriChip('Tôi muốn liên hệ nhân viên kinh doanh / Hotline')">📞 Hotline &amp; Hỗ trợ</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Ô NHẬP TIN NHẮN -->
    <div class="yuri-chat-footer">
      <input type="text" id="yuriChatInput" class="yuri-input-box" placeholder="Hỏi Yuri về tồn kho, chính sách, báo giá..." onkeydown="if(event.key==='Enter') sendYuriMessage()" onfocus="onYuriInputFocus()" />
      <button class="yuri-send-btn" onclick="sendYuriMessage()" title="Gửi tin nhắn">➤</button>
    </div>
  </div>

  <!-- TOGGLE / HOVER BUTTON -->
  <button class="yuri-chat-toggle-btn" id="yuriChatToggleBtn" onclick="togglePinYuriChat(event)">
    <div class="yuri-avatar-circle">
      <span>🌸</span>
      <span class="yuri-online-dot"></span>
    </div>
    <span class="yuri-toggle-label">Yuri AI</span>
    <span class="yuri-toggle-badge">Trợ lý B2B</span>
  </button>
</div>
</body>
</html>
